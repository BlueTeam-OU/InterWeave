#
# The InterWeave daemon of one profile, as a systemd USER unit templated on
# the profile name: `systemctl --user enable --now interweave-daemon@<profile>`.
# Plan section 28 step 4, ADR-0055 decision 6. See ../README.md.
[Unit]
Description=InterWeave transport daemon, profile %i
Documentation=https://github.com/BlueTeam-OU/InterWeave/tree/main/packaging/linux
After=network.target

[Service]
Type=exec
# The account's own binary, not a system-wide install.
ExecStart=%h/.local/bin/transport-daemon --profile %i
# A clean stop is SIGTERM, which the daemon answers by stopping within its
# own grace (`SHUTDOWN_GRACE`, 5 s); systemd waits 30 s before it sends
# SIGKILL, so that grace is not cut short.
KillSignal=SIGTERM
TimeoutStopSec=30
# Exit 1 is a failure the next start may not repeat -- a listen port another
# account holds (the kernel's EADDRINUSE, ADR-0055 decision 5) -- so it is
# retried every 5 s, which stays under the default start limit (5 starts in
# 10 s). Exit 2 is a usage error, which a restart does not mend.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
# SIGHUP is a restart, not a reload: the daemon stops exactly as on SIGTERM
# and exits 75, which is restarted RestartSec= later like a failure but
# logged as a success. Nothing survives it -- every lease is released and
# the new daemon issues fresh epochs -- so a profile change is applied by
# `systemctl --user restart interweave-daemon@<profile>` or this signal.
# There is no ExecReload=. The e2e case reads the number from these lines.
RestartForceExitStatus=75
SuccessExitStatus=75
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
