      "keywords": ["libp2p", "transport", "swarm", "behaviour", "dial", "gate", "admission", "discovery", "kademlia", "gossipsub", "autonat", "relay", "dcutr", "yamux", "noise", "identify", "peer", "endpoint", "conformance", "vendored", "cargo-deny", "advisory"],
