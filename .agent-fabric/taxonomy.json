{
  "version": 1,
  "project": "interweave",
  "note": "Binding rules for InterWeave, a Rust libp2p workspace: the code is p2p-network-dev's, the native client's (crates/human/, the human apps) rust-ui-dev's, the Claude Code Channel bridge and its plugin package (apps/claude-channel/, packaging/claude-plugin/) rust-services-dev's (2026-10-20), the decision records and the stage gates are architect-cto's, the CI wiring is devex-tooling's, the human client's words (the values of its label table) and the English of design/ specifications language-culture's (2026-10-03; design/ 2026-10-16), the design/ specifications themselves ux-designer's, and the agents' wire it will one day carry — the GZCoord protocol, and the channel bridge's conformance to it — is fabric-coordinator's. Written by fabric-coordinator on 2026-09-17, the day the repository became a managed project (agent-fabric projects/registry.json names it).",
  "projects": {"include": ["interweave", "InterWeave"], "exclude": [], "unattributed_bucket": "observer-sessions"},
  "reattribution": {
    "path_markers": {"include": ["projects/InterWeave", "crates/", "third_party/", "architecture/"], "exclude": []},
    "keywords": {"include": ["interweave", "libp2p", "peerid", "endpointid", "gossipsub", "kademlia", "autonat", "dcutr", "circuit relay", "yamux", "noise", "swarm", "transportd"], "exclude": []}
  },
  "roles": [
