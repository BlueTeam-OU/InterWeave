                        border-top-left-radius: 18px;
                        border-top-right-radius: 18px;
                        border-bottom-left-radius: item.at-left ? 6px : 18px;
                        border-bottom-right-radius: item.at-left ? 18px : 6px;
                        // While its menu is open, the bubble keeps a pressed
                        // state layer, so the person sees which message it is
                        // about (look spec section 6).
                        if root.row-menu == row.handle: Rectangle {
                            background: Palette.on-surface.with-alpha(0.1);
                            border-top-left-radius: 18px;
                            border-top-right-radius: 18px;
                            border-bottom-left-radius: item.at-left ? 6px : 18px;
                            border-bottom-right-radius: item.at-left ? 18px : 6px;
                        }
                    }
