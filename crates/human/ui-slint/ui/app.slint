                        // take it out of the layout that sizes the row: the
                        // two paddings cancel, so the content keeps its width.
                        HorizontalLayout {
                            padding-left: item.offset;
                            padding-right: -item.offset;
                        Rectangle {
                            background: Palette.surface;
                    // Under the row's controls, the part of the row that is no
                    // control takes the press. Left to the handler, which grabs
                    // it, a drag the row does not offer ends with no callback,
                    // and the next drag on the row was read as its continuation
                    // (swipe spec section 11, item 5, on a device); taken here, the handler reports a drag only once
                    // it has taken it, and ends every drag it took
