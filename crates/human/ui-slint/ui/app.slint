// Copyright 2026 Andrea Benetton
//
// The reference views (plan §17 (8)), as agreed with rust-ui-dev (relay
// seqs 10823, 10826, 10849, 10867, 10870, 10879, 10882, 10885): every
// string arrives from Rust, already chosen from ui-model's placeholder
// table, and every person action leaves as a raw input the Rust side
// resolves against the model. Nothing here decides what is legal.
//
// Slint has no focus query, so every focusable element reports itself in
// `focus-id` when it gains focus. Rust reads it to move focus after a
// row is taken away only if focus was inside that row, and after the
// snackbar closes under its Undo (swipe spec section 7), and the tests
// read it too. Never shown, never person-facing; an element that can
// take focus and does not report it would leave a stale row named there.

import { Palette as Style } from "std-widgets.slint";

// What a row's swipe does in one direction (design/2026-10-16-message-
// swipe.md section 3): `none` when it does nothing that way, and then the
// row does not move that way.
export enum SwipeKind { none, keep, hide, unkeep, retry, cancel }

// Every icon the views draw, from first-party paths on a 24 x 24 grid:
// each is decorative beside a label or names a control that carries its
// own, so none has an accessible name of its own.
export enum Glyph {
    none,
    // The swipe's and the chips' actions (swipe spec section 7; section 6
    // here).
    keep, unkeep, hide, retry, cancel, source,
    // The app bars (sections 5 and 6) and the composer.
    shield, back, more, send,
    // The device's network state on Chats (#304 F7): online in any form,
    // and offline; unknown has none.
    cloud, cloud-off,
    // The statuses (section 6's table).
    clock, check, check-outline, error, crossed, bookmark,
}

export struct ActionRow {
    // Position in the item's rendered actions: identifies the press,
    // which the Rust side turns back into the action as rendered.
    index: int,
    text: string,
    // Which action it is, for its chip's icon.
    kind: SwipeKind,
}


export struct ConversationRow {
    handle: int,
    // A left swipe hides the conversation (section 10): offered only when
    // it holds nothing unread, kept or pending.
    hide: SwipeKind,
    hide-label: string,
    // The row is leaving the list: its space closes.
    leaving: bool,
    title: string,
    // Says direct or channel as text, never colour alone (U2a), then the
    // unread count when there is one, the preview and the time (section
    // 7): one of two whole templates.
    description: string,
    selected: bool,
    // The avatar (section 5.1): its letters, and its pair -- 0 teal,
    // 1 amber, 2 navy.
    avatar-letters: string,
    avatar-hue: int,
    // The last message's first line, as plain text (section 5.2).
    preview: string,
    // The last message's time, as the list shows it.
    time: string,
    // The unread count's digits; empty when nothing is unread, and then
    // no badge is drawn.
    unread: string,
    // The last message is one's own and on its way: a clock in the
    // badge's place, when nothing is unread.
    pending: bool,
}

// What a body line is: how it is drawn (`body.rs`).
export enum LineKind { text, heading, code, rule, table-header, table-row }

// One line of a body, as plain text: never markup (architect-cto's B6
// ruling -- no second parser reads remote-derived text).
export struct BodyLine {
    kind: LineKind,
    // A heading's level, 1 to 6; 0 otherwise.
    level: int,
    // How many lists and quotes it sits in.
    depth: int,
    quoted: bool,
    // A list item's marker on its first line: a bullet, or "3.".
    marker: string,
    text: string,
}

// One link of a body: a separate control, activated only by a person,
// labelled with its full destination (HUMAN-CHAT.md, human-client-ui.md
// section 13). The index identifies the press, as an action's does.
export struct LinkRow {
    index: int,
    label: string,
}

export struct MessageRow {
    handle: int,
    // Short author, then status, then body (U5a).
    label: string,
    author: string,
    // The full PeerId of an inbound author, exact (§11, U5a); empty for
    // this client's own.
    author-id: string,
    status: string,
    // Why a pending message needs the person, an error class's sentence,
    // drawn above its status; empty for one that does not (look spec
    // section 6, Composer: Android review F16).
    reason: string,
    // Sent by this client: the bubble sits on the end side (section 6).
    outbound: bool,
    // The bubble opens with its author: a channel's received message,
    // once per run from one author.
    show-author: bool,
    // The status's icon, the unread dot before it, and whether both and
    // the words take the error colour (section 6's table).
    status-glyph: Glyph,
    status-dot: bool,
    status-error: bool,
    // The local time it reached this app.
    time: string,
    // The space above it: 2 px within a run, 8 px between runs.
    gap: length,
    // The day separator above it; empty for none.
    day: string,
    // A leaving row whose day separator the next row takes over once it is
    // gone: its gap and separator stay while only its item closes.
    hand-over: bool,
    // The source as received, shown on the person's request: always
    // viewable, however it rendered (HUMAN-CHAT.md).
    source: string,
    // The body drawn from the block tree, and its links.
    lines: [BodyLine],
    links: [LinkRow],
    reply: string,
    actions: [ActionRow],
    // The swipe toward the end of a line (right, left to right) and
    // toward its start, and the label beside each one's icon.
    end-kind: SwipeKind,
    end-label: string,
    start-kind: SwipeKind,
    start-label: string,
    // The row is leaving the list: its space closes.
    leaving: bool,
}

// A trusted peer: its full PeerId, exact, where it comes from (the
// profile's configuration, or added here), and a handle the press names it
// by.
export struct TrustRow {
    handle: int,
    peer: string,
    origin: string,
}

// One address on Peers (design/2026-10-22-add-a-peer.md section 5.2): its
// peer in short, the host and port in the code font, its state and origin
// in words, and what its row offers.
export struct PeerAddressRow {
    handle: int,
    peer: string,
    host: string,
    // The whole address, which Copy address copies.
    address: string,
    state: string,
    origin: string,
    // Not trusted: the row offers Trust.
    needs-trust: bool,
    // Added here: the menu offers Remove; a configuration row says why not.
    removable: bool,
    menu-label: string,
}

// One step-two block of the add page (section 5.3): one PeerId of the add
// not trusted yet.
export struct PeerTrustBlock {
    handle: int,
    title: string,
    // The full PeerId, exact, for the person to compare.
    peer: string,
    // Trust or Not now still to choose.
    undecided: bool,
    // Trust is offered: not after a problem no retry mends.
    trust-offered: bool,
    // Its state once decided, or its Trust on its way.
    state: string,
    // Why its last Trust did not trust it.
    problem: string,
}

// The platform's touch slop, which Rust sets from the system's
// (swipe spec section 4).
// The identity screens (design/2026-10-19-android-identity.md): one page
// at a time, filled from ui-model's IdentityFlow by the Rust side, so the
// view holds no flow of its own.
export struct IdKey {
    letter: string,
    enabled: bool,
}

export struct IdKeyRow {
    keys: [IdKey],
}

export struct IdSlot {
    number: int,
    word: string,
    current: bool,
}

export struct IdentityPage {
    title: string,
    paragraphs: [string],
    // An inline banner (section 6), above the content; empty for none.
    notice: string,
    peer-label: string,
    // A PeerId grouped by fours for comparing by eye (section 5).
    peer-groups: string,
    second-peer-label: string,
    second-peer-groups: string,
    // C2's and S2's numbered words.
    words: [IdSlot],
    // The picker (section 4), on C3 and R2.
    picker: bool,
    position: string,
    typed: string,
    // "{n} words fit these letters" while more than four match.
    matches: string,
    chips: [string],
    // The letters in QWERTY rows of 10, 9 and 7, and in alphabetical
    // rows of 7 for a narrow screen: the view picks by width (section
    // 4.3). Rows, so a shorter row centres under the first.
    rows: [IdKeyRow],
    alpha-rows: [IdKeyRow],
    key-delete-label: string,
    key-clear-label: string,
    // R2's phrase so far.
    grid: [IdSlot],
    primary: string,
    primary-enabled: bool,
    // The store's key-lost screen: the primary deletes stored data, in
    // `error` (design 2026-10-21 section 7.1).
    primary-danger: bool,
    // A progress line in place of the primary action ("Going offline…").
    waiting: string,
    secondary: string,
    // The store's recovery screen: the secondary deletes stored data,
    // outlined in `error`.
    secondary-danger: bool,
    tertiary: string,
    // Plain text below the actions (K1's way out, R3's no-paper line).
    footnote: string,
    dialog: bool,
    dialog-title: string,
    dialog-delete: string,
    dialog-keep: string,
    // The store's discard confirmation (design 2026-10-21 section 7.2):
    // the list's lead-in, what goes one item per line, what stays and
    // what the device may still hold; the delete action filled in
    // `error` when it loses data.
    dialog-lead: string,
    dialog-items: [string],
    dialog-note-a: string,
    dialog-note-b: string,
    dialog-danger: bool,
}

// Whether the person is using the keyboard: focus that came by Tab sets
// it, focus that came by a pointer, or any press, clears it. The focus
// ring is for keyboard focus only (#304 F5): a touch user sees none, even
// where a rule moves focus after an action, which it does for keyboard
// and screen-reader users.
export global FocusMode {
    in-out property <bool> keyboard;
}

export global Touch {
    in property <length> slop: 8px;
    // The platform's long-press time (Android's
    // ViewConfiguration.getLongPressTimeout): a press held this long within
    // the slop opens a message's menu (swipe spec section 4).
    in property <duration> long-press: 500ms;
    // The system's animations are off: a press shows no ripple.
    in property <bool> reduced-motion;
}

// The pressed state layer, in the control's shape. A ripple grows to twice
// the control's diagonal; the layer's clip cuts it at that shape.
component StateLayer inherits Rectangle {
    in property <length> radius;
    clip: true;
    border-radius: root.radius;
    background: Palette.on-surface.with-alpha(0.1);
    accessible-role: none;
}

// A ripple: a circle growing from the press point until it covers the
// control. Only drawn while animations are on.
component Ripple inherits Rectangle {
    in property <length> cx;
    in property <length> cy;
    in property <length> reach;
    property <length> size: 0px;
    init => { self.size = root.reach * 2; }
    animate size { duration: 250ms; easing: ease-out; }
    x: root.cx - self.size / 2;
    y: root.cy - self.size / 2;
    width: self.size;
    height: self.size;
    border-radius: self.size / 2;
    background: Palette.on-surface.with-alpha(0.12);
    accessible-role: none;
}

// A control's touch area: a press is its tap only while the finger stays
// within the slop of where it went down (swipe spec section 4). A drag
// that passes it is a swipe or a scroll, whether or not the row offers
// one, and never presses the control under it -- a drag along a Chats
// row once opened and read the conversation it crossed (tests/pointer.rs,
// `a_drag_from_a_rows_button_never_presses_it_and_a_tap_does` and
// `a_drag_on_a_conversation_row_offering_no_swipe_opens_and_reads_nothing`).
// Inside a scrolling list the press reaches it about 100 ms late, and a
// wander out and back before then is not seen: the release is checked
// too, so only that is still a tap.
component TapArea inherits TouchArea {
    callback tapped();
    // The pressed control's corner radius, which its press feedback keeps,
    // and how far its drawn shape sits inside the touch area top and
    // bottom (a chip is drawn 32 px in a 48 px target).
    in property <length> radius;
    in property <length> inset-y;
    property <bool> drifted;
    function past-slop() -> bool {
        abs(self.mouse-x - self.pressed-x) > Touch.slop
            || abs(self.mouse-y - self.pressed-y) > Touch.slop
    }
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            self.drifted = false;
            FocusMode.keyboard = false;
        }
    }
    moved => {
        if (self.past-slop()) { self.drifted = true; }
    }
    clicked => {
        if (!self.drifted && !self.past-slop()) { root.tapped(); }
    }
    // A press's feedback (section 7): Material's state layer, on-surface at
    // 10 %, while a tap is still possible, and over it the ripple from the
    // press point -- unless the system's animations are off, when the flat
    // layer alone shows it (tests/look.rs,
    // `a_press_ripples_unless_animations_are_off`).
    if root.pressed && !root.drifted: StateLayer {
        y: root.inset-y;
        height: root.height - 2 * root.inset-y;
        radius: root.radius;
        if !Touch.reduced-motion: Ripple {
            cx: root.pressed-x;
            cy: root.pressed-y - root.inset-y;
            reach: sqrt((root.width / 1px) * (root.width / 1px) + (root.height / 1px) * (root.height / 1px)) * 1px;
        }
    }
}



// Where keyboard focus is: a 3 px ring 2 px outside the control's edge
// (design/2026-10-16-android-look.md section 7), so focus never depends on
// a border's width or on colour inside the control. Every focusable
// element draws one (tests/views.rs,
// `every_tab_stop_draws_exactly_one_focus_ring`). The user places it with
// x and y, five px out on each side: an element whose x or y is set does
// not count toward its parent's size, so the ring moves no layout. A
// container that clips keeps five px of padding around its controls, or
// the ring is cut there.
component FocusRing inherits Rectangle {
    in property <bool> shown;
    // On the notice banner, whose background is light in both schemes.
    in property <bool> on-notice;
    // On the snackbar, whose surface is the inverse of the screen's.
    in property <bool> on-inverse;
    // The control's own corner radius; the ring follows its shape.
    in property <length> radius: 4px;
    border-width: 3px;
    border-color: root.on-notice ? Palette.focus-ring-on-notice
        : root.on-inverse ? Palette.focus-ring-on-inverse
        : Palette.primary;
    border-radius: root.radius + 5px;
    // Opacity rather than `visible`, so a test reads it.
    opacity: root.shown && FocusMode.keyboard ? 1 : 0;
}

component ActionButton inherits FocusScope {
    focus-gained(reason) => {
        if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
        if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
    }
    in property <string> text;
    in property <string> focus-key;
    // The least touch target: 48 on a message row and the snackbar,
    // Android's and WCAG 2.5.8's (swipe spec section 7).
    in property <length> target: 24px;
    // A focus request: each new `focus-seq` focuses the one control whose
    // `focus-wanted` is true then (swipe spec section 7's focus rules).
    in property <int> focus-seq;
    in property <bool> focus-wanted;
    changed focus-seq => {
        if (root.focus-wanted) { root.focus(); }
    }
    // What the control acts on, when its label alone does not say it: a
    // list's "Remove trust" names its peer here.
    in property <string> detail;
    callback pressed();
    callback focused(string);
    accessible-role: button;
    accessible-label: text;
    accessible-description: detail;
    accessible-action-default => { root.pressed(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.pressed();
            return accept;
        }
        reject
    }
    changed has-focus => {
        if (self.has-focus) { root.focused(root.focus-key); }
    }
    // On the notice banner, which is light in both schemes: the label,
    // border and ring take its colours, or a dark scheme's light label
    // was all but invisible on it (seen in the rendered window).
    in property <bool> on-notice;
    // On the snackbar (section 7): its ring takes the inverse colour.
    in property <bool> on-inverse;
    // A text button: no border, the label in `ink` and label large.
    in property <bool> text-button;
    // A filled button: `primary` behind an `on-primary` label, fully
    // rounded, label large (Material's filled button).
    in property <bool> filled;
    // A destructive action: filled in `error` with an `on-error` label, or
    // outlined with its border and label in `error` (design 2026-10-21
    // section 7's Delete stored data).
    in property <bool> danger;
    in property <color> ink: Palette.primary;
    min-height: root.target;
    // Never narrower than its label: squeezed beside a wrapping text, the
    // label ran out of the button (seen in the rendered window).
    min-width: max(root.target, label.preferred-width + (root.filled ? 48px : 16px));
    Rectangle {
        border-width: root.text-button || root.filled ? 0px : 1px;
        border-color: root.on-notice ? Palette.notice-text
            : root.danger ? Palette.error : Palette.outline;
        background: root.filled ? (root.danger ? Palette.error : Palette.primary) : transparent;
        border-radius: root.filled ? self.height / 2 : 0px;
        HorizontalLayout {
            padding-left: root.filled ? 24px : 8px;
            padding-right: root.filled ? 24px : 8px;
            // The caption is the button's label already: not a second node.
            label := Text {
                text: root.text;
                font-size: root.text-button || root.filled ? Type.label-large : Type.body-medium;
                font-weight: root.text-button || root.filled ? 500 : 400;
                color: root.filled ? (root.danger ? Palette.on-error : Palette.on-primary)
                    : root.text-button ? root.ink : root.on-notice ? Palette.notice-text
                    : root.danger ? Palette.error : Palette.on-surface;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
    TapArea { tapped => { root.pressed(); } }
    FocusRing {
        x: -5px;
        y: -5px;
        width: root.width + 10px;
        height: root.height + 10px;
        radius: root.filled ? self.height / 2 : 0px;
        shown: root.has-focus;
        on-notice: root.on-notice;
        on-inverse: root.on-inverse;
    }
}

// A heading that takes keyboard and screen-reader focus and does
// nothing when activated (swipe spec section 7): where focus goes once
// the rows below it are gone, so focus is never lost.
component FocusHeading inherits FocusScope {
    focus-gained(reason) => {
        if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
        if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
    }
    in property <string> text;
    in property <string> description;
    in property <string> focus-key;
    in property <length> font-size: Type.title-medium;
    in property <int> font-weight: 700;
    in property <bool> rtl;
    in property <int> focus-seq;
    in property <bool> focus-wanted;
    changed focus-seq => {
        if (root.focus-wanted) { root.focus(); }
    }
    callback focused(string);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-description: root.description;
    changed has-focus => {
        if (self.has-focus) { root.focused(root.focus-key); }
    }
    // The layout is the only child counted for the heading's size, so it
    // takes its text's height; the ring is placed, and not counted.
    VerticalLayout {
        HorizontalLayout {
            Text {
                text: root.text;
                font-weight: root.font-weight;
                font-size: root.font-size;
                color: Palette.on-surface;
                overflow: elide;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                accessible-role: none;
            }
        }
    }
    FocusRing {
        x: -5px;
        y: -5px;
        width: root.width + 10px;
        height: root.height + 10px;
        shown: root.has-focus;
    }
}

// A line that takes focus, as FocusHeading does, and wraps where a
// heading elides: a note a person must read whole, whatever its length --
// a refusal naming an address, a problem in place of a list. Its minimum
// width is nothing, so one long address in it never widens the page.
component FocusNote inherits FocusScope {
    focus-gained(reason) => {
        if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
        if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
    }
    in property <string> text;
    in property <string> focus-key;
    in property <color> ink: Palette.on-surface;
    in property <length> font-size: Type.body-medium;
    in property <int> font-weight: 400;
    in property <bool> rtl;
    in property <int> focus-seq;
    in property <bool> focus-wanted;
    changed focus-seq => {
        if (root.focus-wanted) { root.focus(); }
    }
    callback focused(string);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    changed has-focus => {
        if (self.has-focus) { root.focused(root.focus-key); }
    }
    // The layout is the only child counted for the note's size, as the
    // heading's; the ring is placed.
    VerticalLayout {
        Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: root.font-weight;
            color: root.ink;
            wrap: word-wrap;
            min-width: 0;
            horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            accessible-role: none;
        }
    }
    FocusRing {
        x: -5px;
        y: -5px;
        width: root.width + 10px;
        height: root.height + 10px;
        shown: root.has-focus;
    }
}

// A link's control: its label is the full destination, which may be
// long and have no spaces, so it wraps -- inside a word if it must --
// rather than widening the window, and reads from the left.
component LinkButton inherits FocusScope {
    focus-gained(reason) => {
        if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
        if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
    }
    in property <string> text;
    in property <string> focus-key;
    // Its colour: `primary` in a received bubble, the bubble's own text
    // colour in a sent one (section 6).
    in property <color> ink: Palette.primary;
    callback pressed();
    callback focused(string);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.pressed(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.pressed();
            return accept;
        }
        reject
    }
    changed has-focus => {
        if (self.has-focus) { root.focused(root.focus-key); }
    }
    // The layout is the only child counted for the control's size, the
    // touch area inside it: with a sibling beside the layout the control
    // kept one line's height whatever the destination wrapped to, and the
    // lines below overlapped the next control (seen in the rendered
    // window). The focus ring is placed by x and y, and so not counted.
    VerticalLayout {
        // A 48 px target, as the link buttons were (section 6).
        min-height: 48px;
        alignment: center;
        Rectangle {
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 1px;
                Text {
                    text: root.text;
                    color: root.ink;
                    font-size: Type.body-medium;
                    wrap: word-wrap;
                    // A word longer than the line breaks inside itself
                    // rather than widening the list (seen with a long URL).
                    min-width: 0;
                    horizontal-alignment: left;
                    accessible-role: none;
                }
                // Underlined: Slint's Text has no underline of its own.
                Rectangle {
                    height: 1px;
                    background: root.ink;
                }
            }
            TapArea { tapped => { root.pressed(); } }
        }
    }
    FocusRing {
        x: -5px;
        y: -5px;
        width: root.width + 10px;
        height: root.height + 10px;
        radius: 0px;
        shown: root.has-focus;
    }
}

// Colours: the roles of design/2026-10-16-android-look.md section 3, each
// in the scheme the platform asks for. Every pair that section's contrast
// table names holds its need in both schemes (tests/look.rs,
// `every_contrast_pair_of_section_3_meets_its_need`, measures them from
// here). Exported, and the scheme aliased, so that test can switch it.
export global Palette {
    in-out property <ColorScheme> scheme <=> Style.color-scheme;
    out property <bool> dark: Style.color-scheme == ColorScheme.dark;
    out property <color> surface: dark ? #11152a : #f8f9ff;
    out property <color> surface-container: dark ? #171c33 : #eef0fa;
    out property <color> surface-container-high: dark ? #232a47 : #e6e9f5;
    out property <color> on-surface: dark ? #e3e6f3 : #161b2e;
    out property <color> on-surface-variant: dark ? #b9bfd6 : #4a5068;
    out property <color> outline: dark ? #6b7396 : #767c95;
    out property <color> primary: dark ? #5fdccd : #006a61;
    out property <color> on-primary: dark ? #00201d : #ffffff;
    out property <color> primary-container: dark ? #004d46 : #9ff2e5;
    out property <color> on-primary-container: dark ? #b8fff4 : #00201d;
    out property <color> tertiary: #ffb547;
    out property <color> on-tertiary: #2a1800;
    out property <color> unread-dot: dark ? #ffb547 : #7c5200;
    out property <color> error: dark ? #ffb4ab : #ba1a1a;
    // A label on `error` (Delete stored data, design 2026-10-21 section
    // 7): #ffffff on #ba1a1a is 6.4:1, #690005 on #ffb4ab 7.6:1.
    out property <color> on-error: dark ? #690005 : #ffffff;
    // The snackbar's roles (section 7): its surface, its text, its Undo,
    // and focus-ring-on-inverse below for the Undo's ring.
    out property <color> inverse-surface: dark ? #e3e6f3 : #2a3050;
    out property <color> inverse-on-surface: dark ? #2a3050 : #eef0fb;
    out property <color> inverse-primary: dark ? #006a61 : #5fdccd;
    // Where keyboard focus is (section 7): `primary` on the surfaces and
    // bubbles, these two on the snackbar and on a notice banner.
    out property <color> focus-ring-on-inverse: dark ? #006a61 : #5fdccd;
    out property <color> focus-ring-on-notice: #006a61;
    // The storage notice stands apart from everything else on screen, in
    // both schemes.
    out property <color> notice-background: #fff4ce;
    out property <color> notice-text: #3d2c00;
    // The swipe roles (swipe spec section 7, narrowed by section 3 here):
    // the neutral fill holds 3:1 against every background a row has --
    // the surfaces and both bubbles -- and its icon and label 4.5:1 on it,
    // which in dark takes a dark ink, since white on that grey would fail.
    // The armed fills need no contrast against each other, since colour is
    // never the only sign of arming.
    out property <color> swipe-neutral: dark ? #9aa1bb : #707070;
    out property <color> swipe-on-neutral: dark ? #11152a : #ffffff;
    out property <color> swipe-keep: #1b6e3a;
    out property <color> swipe-remove: #b3261e;
    out property <color> swipe-retry: #1f5fbf;
    out property <color> swipe-on-fill: #ffffff;
    // An avatar's three pairs (section 5.1), each 4.5:1 for its text.
    out property <color> avatar-teal: dark ? #004d46 : #9ff2e5;
    out property <color> on-avatar-teal: dark ? #b8fff4 : #00201d;
    out property <color> avatar-amber: dark ? #5c3d00 : #ffdea8;
    out property <color> on-avatar-amber: dark ? #ffdea8 : #2a1800;
    out property <color> avatar-navy: dark ? #2e3a74 : #dde1ff;
    out property <color> on-avatar-navy: dark ? #dde1ff : #141a3a;
}

// The type scale of section 4, in the platform's text size: `rem` is the
// window's default font size, which the Android backend sets from the
// system's font scale (14 at 100 %, Material's body medium), so every size
// here follows the person's setting.
global Type {
    out property <relative-font-size> title-large: 22rem / 14;
    out property <relative-font-size> title-medium: 16rem / 14;
    out property <relative-font-size> title-small: 14rem / 14;
    out property <relative-font-size> body-large: 16rem / 14;
    out property <relative-font-size> body-medium: 14rem / 14;
    out property <relative-font-size> body-small: 12rem / 14;
    out property <relative-font-size> label-large: 14rem / 14;
}

component GlyphIcon {
    in property <Glyph> glyph;
    in property <color> ink;
    // The back arrow points toward the line's start: right, right to left.
    in property <bool> rtl;
    width: 24px;
    height: 24px;
    property <string> stroked:
        glyph == Glyph.keep ? "M 6 3 L 18 3 L 18 21 L 12 17 L 6 21 Z M 12 7 L 12 13 M 9 10 L 15 10"
        : glyph == Glyph.unkeep ? "M 6 3 L 18 3 L 18 21 L 12 17 L 6 21 Z M 9 10 L 15 10"
        : glyph == Glyph.hide ? "M 2 12 C 5 6 19 6 22 12 C 19 18 5 18 2 12 Z M 12 9 A 3 3 0 1 1 12 15 A 3 3 0 1 1 12 9 Z M 3 3 L 21 21"
        : glyph == Glyph.retry ? "M 20 12 A 8 8 0 1 1 17.66 6.34 M 18 2 L 18 7 L 13 7"
        : glyph == Glyph.cancel ? "M 6 6 L 18 18 M 18 6 L 6 18"
        : glyph == Glyph.source ? "M 8 7 L 3 12 L 8 17 M 16 7 L 21 12 L 16 17"
        : glyph == Glyph.shield ? "M 12 2 L 20 5 L 20 11 C 20 16 16.5 20 12 22 C 7.5 20 4 16 4 11 L 4 5 Z"
        : glyph == Glyph.back && !rtl ? "M 20 12 L 4 12 M 10 6 L 4 12 L 10 18"
        : glyph == Glyph.back ? "M 4 12 L 20 12 M 14 6 L 20 12 L 14 18"
        : glyph == Glyph.clock ? "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3 Z M 12 7 L 12 12 L 16 14"
        : glyph == Glyph.check ? "M 5 12 L 10 17 L 19 7"
        : glyph == Glyph.check-outline ? "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3 Z M 8 12 L 11 15 L 16 9"
        : glyph == Glyph.error ? "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3 Z M 12 7 L 12 13 M 12 16 L 12 17"
        : glyph == Glyph.crossed ? "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3 Z M 5.6 5.6 L 18.4 18.4"
        : glyph == Glyph.cloud-off ? "M 7 19 A 4.5 4.5 0 0 1 6.2 10.05 A 6 6 0 0 1 17.6 9.1 A 5 5 0 0 1 17 19 Z M 3 3 L 21 21"
        : "";
    property <string> filled:
        glyph == Glyph.more ? "M 12 4 A 2 2 0 1 1 12 8 A 2 2 0 1 1 12 4 Z M 12 10 A 2 2 0 1 1 12 14 A 2 2 0 1 1 12 10 Z M 12 16 A 2 2 0 1 1 12 20 A 2 2 0 1 1 12 16 Z"
        : glyph == Glyph.send && !rtl ? "M 3 20 L 21 12 L 3 4 L 3 10 L 15 12 L 3 14 Z"
        : glyph == Glyph.send ? "M 21 20 L 3 12 L 21 4 L 21 10 L 9 12 L 21 14 Z"
        : glyph == Glyph.bookmark ? "M 6 3 L 18 3 L 18 21 L 12 17 L 6 21 Z"
        : glyph == Glyph.cloud ? "M 7 19 A 4.5 4.5 0 0 1 6.2 10.05 A 6 6 0 0 1 17.6 9.1 A 5 5 0 0 1 17 19 Z"
        : "";
    if root.stroked != "": Path {
        width: root.width;
        height: root.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.stroked;
        stroke: root.ink;
        stroke-width: 2px;
    }
    if root.filled != "": Path {
        width: root.width;
        height: root.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.filled;
        fill: root.ink;
    }
}

// An action's icon, as a swipe uncovers it.
component SwipeIcon inherits GlyphIcon {
    in property <SwipeKind> kind;
    glyph: kind == SwipeKind.keep ? Glyph.keep
        : kind == SwipeKind.unkeep ? Glyph.unkeep
        : kind == SwipeKind.hide ? Glyph.hide
        : kind == SwipeKind.retry ? Glyph.retry
        : kind == SwipeKind.cancel ? Glyph.cancel
        : Glyph.none;
}

// A control that is an icon: a round 48 px target (Android's and WCAG
// 2.5.8's), its label the icon's meaning, and a round focus ring.
component IconButton inherits FocusScope {
    focus-gained(reason) => {
        if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
        if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
    }
    in property <Glyph> glyph;
    in property <string> label;
    in property <string> focus-key;
    in property <color> ink: Palette.on-surface-variant;
    // A filled round button: the icon in `on-primary` on `primary`.
    in property <bool> filled;
    // Inactive: drawn at 38 % and does nothing when pressed, though it
    // still takes focus, so its label stays reachable.
    in property <bool> active: true;
    in property <bool> rtl;
    in property <int> focus-seq;
    in property <bool> focus-wanted;
    changed focus-seq => {
        if (root.focus-wanted) { root.focus(); }
    }
    callback pressed();
    callback focused(string);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.active;
    accessible-action-default => { root.press(); }
    function press() {
        if (root.active) { root.pressed(); }
    }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.press();
            return accept;
        }
        reject
    }
    changed has-focus => {
        if (self.has-focus) { root.focused(root.focus-key); }
    }
    width: 48px;
    height: 48px;
    Rectangle {
        opacity: root.active ? 1 : 0.38;
        background: root.filled ? Palette.primary : transparent;
        border-radius: 24px;
        GlyphIcon {
            x: 12px;
            y: 12px;
            glyph: root.glyph;
            ink: root.filled ? Palette.on-primary : root.ink;
            rtl: root.rtl;
        }
    }
    TapArea {
        radius: 24px;
        tapped => { root.press(); }
    }
    FocusRing {
        x: -5px;
        y: -5px;
        width: root.width + 10px;
        height: root.height + 10px;
        radius: 24px;
        shown: root.has-focus;
    }
}

// A conversation's avatar (section 5.1): decoration beside the name, never
// read by a screen reader and never a trust signal.
component Avatar inherits Rectangle {
    in property <string> letters;
    // 0 teal, 1 amber, 2 navy.
    in property <int> hue;
    in property <length> size: 40px;
    accessible-role: none;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: hue == 1 ? Palette.avatar-amber : hue == 2 ? Palette.avatar-navy : Palette.avatar-teal;
    Text {
        text: root.letters;
        font-size: Type.label-large;
        font-weight: 500;
        color: hue == 1 ? Palette.on-avatar-amber : hue == 2 ? Palette.on-avatar-navy : Palette.on-avatar-teal;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// What a swipe uncovers: the action's icon and its label on the side the
// row left, on the neutral fill until armed and the action's colour once
// armed -- with the icon scaled up, so colour is never the only sign
// (swipe spec section 7). For sight only: the row's buttons are what a
// screen reader reaches.
component SwipeReveal inherits Rectangle {
    in property <SwipeKind> kind;
    in property <string> label;
    in property <bool> armed;
    // The uncovered side is the left (the row moved right).
    in property <bool> at-left;
    in property <bool> reduced-motion;
    accessible-role: none;
    background: !root.armed ? Palette.swipe-neutral
        : root.kind == SwipeKind.keep ? Palette.swipe-keep
        : root.kind == SwipeKind.retry ? Palette.swipe-retry
        : Palette.swipe-remove;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: root.at-left ? start : end;
        icon := SwipeIcon {
            kind: root.kind;
            ink: root.armed ? Palette.swipe-on-fill : Palette.swipe-on-neutral;
            y: (parent.height - self.height) / 2;
            transform-scale: root.armed ? 1.2 : 1.0;
            animate transform-scale { duration: root.reduced-motion ? 0ms : 100ms; }
        }
        Text {
            text: root.label;
            color: root.armed ? Palette.swipe-on-fill : Palette.swipe-on-neutral;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The snackbar: what a swipe or a row button did, and its Undo while one
// is offered (swipe spec section 6). Its text is announced through the
// window's one live region when it opens, not by itself. A swipe either
// way dismisses it.
component Snackbar inherits Rectangle {
    in property <string> text;
    in property <bool> undo;
    in property <string> undo-label;
    in property <int> snack-id;
    in property <int> focus-seq;
    // A right-to-left layout: the Undo sits at the line's end, the left
    // (swipe spec section 3).
    in property <bool> rtl;
    callback undo-pressed(int);
    callback dismissed(int);
    callback focused(string);
    // Material's snackbar (section 7): the inverse surface, 4 px corners,
    // at least 48 px tall.
    background: Palette.inverse-surface;
    border-radius: 4px;
    min-height: 48px;
    SwipeGestureHandler {
        handle-swipe-left: true;
        handle-swipe-right: true;
        swiped => { root.dismissed(root.snack-id); }
        // The Undo sits at the line's end in either direction. It is
        // placed, not laid out, so the tree keeps the text before it in
        // both: a screen reader reads what happened, then its Undo.
        HorizontalLayout {
            padding: 8px;
            padding-left: root.rtl ? 8px : 12px;
            padding-right: root.rtl ? 12px : 8px;
            spacing: 8px;
            if root.undo && root.rtl: Rectangle {
                width: root.undo-width;
                min-height: 48px;
            }
            Text {
                text: root.text;
                wrap: word-wrap;
                min-width: 0;
                horizontal-stretch: 1;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                vertical-alignment: center;
                font-size: Type.body-medium;
                color: Palette.inverse-on-surface;
                accessible-role: AccessibleRole.text;
                accessible-label: self.text;
            }
            if root.undo && !root.rtl: Rectangle {
                width: root.undo-width;
                min-height: 48px;
            }
        }
        if root.undo: ActionButton {
            x: root.rtl ? 8px : parent.width - self.width - 8px;
            y: (parent.height - self.height) / 2;
            width: root.undo-width;
            height: 48px;
            text: root.undo-label;
            detail: root.text;
            target: 48px;
            // A text button in inverse-primary, its ring the inverse one.
            text-button: true;
            ink: Palette.inverse-primary;
            on-inverse: true;
            focus-key: "undo";
            pressed => { root.undo-pressed(root.snack-id); }
            focused(k) => { root.focused(k); }
        }
    }
    // The Undo's width, from its label as ActionButton draws it (8 px each
    // side), at least the 48 px touch target.
    property <length> undo-width: max(48px, undo-measure.preferred-width + 16px);
    undo-measure := Text {
        text: root.undo-label;
        font-size: Type.label-large;
        font-weight: 500;
        visible: false;
        accessible-role: none;
    }
}

// One entry of a menu: 48 px tall, its label at the start, a focus ring
// that follows the row. Escape closes the menu.
component MenuItem inherits FocusScope {
    focus-gained(reason) => {
        if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
        if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
    }
    in property <string> text;
    in property <string> detail;
    in property <string> focus-key;
    // A message's menu shows each action's icon, 24 px in
    // `on-surface-variant` before its label (look spec section 6): a swipe
    // kind's, or `glyph`'s for one that is no swipe's (Show source).
    in property <bool> iconed;
    in property <SwipeKind> kind;
    in property <Glyph> glyph: Glyph.none;
    // The menu's first entry takes focus when the menu opens.
    in property <bool> first;
    in property <bool> rtl;
    callback pressed();
    callback closed();
    callback focused(string);
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-action-default => { root.pressed(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.pressed();
            return accept;
        }
        if (event.text == Key.Escape) {
            root.closed();
            return accept;
        }
        reject
    }
    changed has-focus => {
        if (self.has-focus) { root.focused(root.focus-key); }
    }
    // Focus moves to it once it is in the window: a focus asked for from
    // `init` is lost, since the entry is not in the focus chain yet.
    property <bool> taken;
    Timer {
        interval: 1ms;
        running: root.first && !root.taken;
        triggered => {
            root.taken = true;
            root.focus();
        }
    }
    min-height: 48px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        if root.iconed && !root.rtl: VerticalLayout {
            alignment: center;
            if root.glyph != Glyph.none: GlyphIcon {
                width: 24px;
                height: 24px;
                glyph: root.glyph;
                ink: Palette.on-surface-variant;
            }
            if root.glyph == Glyph.none: SwipeIcon {
                width: 24px;
                height: 24px;
                kind: root.kind;
                ink: Palette.on-surface-variant;
            }
        }
        Text {
            text: root.text;
            font-size: Type.body-large;
            color: Palette.on-surface;
            vertical-alignment: center;
            // At 200 % a label wraps rather than being cut (section 8).
            wrap: word-wrap;
            horizontal-stretch: 1;
            horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            accessible-role: none;
        }
        if root.iconed && root.rtl: VerticalLayout {
            alignment: center;
            if root.glyph != Glyph.none: GlyphIcon {
                width: 24px;
                height: 24px;
                glyph: root.glyph;
                ink: Palette.on-surface-variant;
            }
            if root.glyph == Glyph.none: SwipeIcon {
                width: 24px;
                height: 24px;
                kind: root.kind;
                ink: Palette.on-surface-variant;
            }
        }
    }
    TapArea { tapped => { root.pressed(); } }
    FocusRing {
        x: -5px;
        y: -5px;
        width: root.width + 10px;
        height: root.height + 10px;
        radius: 0px;
        shown: root.has-focus;
    }
}

// The unread badge (section 5): the count on a tertiary pill, 20 px tall.
// The row's description says the count; the badge is for sight.
component UnreadBadge inherits Rectangle {
    in property <string> count;
    accessible-role: none;
    height: 20px;
    min-width: 20px;
    border-radius: 10px;
    background: Palette.tertiary;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.count;
            font-size: Type.body-small;
            font-weight: 500;
            color: Palette.on-tertiary;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

/// A session notice: about the whole client, not one conversation, with
/// the one action that answers it, if any. Shown wherever the person is:
/// in the conversation pane, and on a phone's Chats as well, where a
/// fresh profile has no conversation to open.
component NoticeCard inherits Rectangle {
    in property <string> message;
    in property <bool> has-action;
    in property <string> action;
    callback pressed();
    callback focused(string);
    background: Palette.notice-background;
    border-radius: 12px;
    HorizontalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: root.message;
            color: Palette.notice-text;
            wrap: word-wrap;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: self.text;
            accessible-live-region: polite;
        }
        if root.has-action: ActionButton {
            text: root.action;
            focus-key: "notice";
            on-notice: true;
            pressed => { root.pressed(); }
            focused(k) => { root.focused(k); }
        }
    }
}

// The identity screens' page. FLAG_SECURE, the no-clipboard rule and the
// IME-free entry are kept by what is NOT here: no TextInput, so no
// system keyboard and no copy of a word; the window's secure flag is the
// platform's (human-android).
component IdentityScreen inherits FocusScope {
    focus-gained(reason) => {
        if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
        if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
    }
    in property <IdentityPage> page;
    in property <bool> rtl;
    // A monospace face resolved by the Rust side: "monospace" by name
    // matches nothing in Slint 1.18 and falls back to sans.
    in property <string> code-font;
    in property <length> inset-top;
    in property <length> inset-bottom;
    in property <length> inset-left;
    in property <length> inset-right;
    callback primary();
    callback secondary();
    callback tertiary();
    callback back();
    callback key(string);
    callback delete-letter();
    callback clear-word();
    callback chip(string);
    callback slot(int);
    callback dialog(bool);
    // A hardware keyboard enters letters (acceptance item 15); Escape is
    // Back.
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.back();
            return accept;
        }
        if (event.text == Key.Backspace && root.page.picker) {
            root.delete-letter();
            return accept;
        }
        if (root.page.picker && event.text >= "a" && event.text <= "z" && event.text.character-count == 1) {
            root.key(event.text);
            return accept;
        }
        if (event.text == Key.Return && root.page.picker && root.page.chips.length == 1) {
            root.chip(root.page.chips[0]);
            return accept;
        }
        reject
    }
    Rectangle { background: Palette.surface; }
    // Nothing behind the page is reachable while it shows.
    TouchArea { }
    VerticalLayout {
        padding-top: root.inset-top + 8px;
        padding-bottom: root.inset-bottom + 8px;
        padding-left: root.inset-left + 16px;
        padding-right: root.inset-right + 16px;
        spacing: 12px;
        Text {
            text: root.page.title;
            font-size: Type.title-large;
            font-weight: 500;
            color: Palette.on-surface;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;
            content := VerticalLayout {
                spacing: 12px;
                alignment: start;
                if root.page.notice != "": Rectangle {
                    background: Palette.surface-container;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.page.notice;
                            color: Palette.error;
                            font-size: Type.body-medium;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-label: self.text;
                        }
                    }
                }
                for paragraph in root.page.paragraphs: Text {
                    text: paragraph;
                    font-size: Type.body-large;
                    color: Palette.on-surface;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                // The words, read down the first column then the second;
                // one column when narrow (section 3.2, C2).
                if root.page.words.length > 0: GridLayout {
                    spacing: 8px;
                    property <int> per-column: root.width < 360px ? 24 : 12;
                    for slot[i] in root.page.words: HorizontalLayout {
                        row: mod(i, parent.per-column);
                        col: floor(i / parent.per-column);
                        spacing: 8px;
                        Text {
                            text: slot.number;
                            min-width: 24px;
                            horizontal-alignment: right;
                            font-size: Type.body-large;
                            color: Palette.on-surface-variant;
                            accessible-role: none;
                        }
                        Text {
                            text: slot.word;
                            font-size: Type.body-large;
                            color: Palette.on-surface;
                            accessible-role: text;
                            accessible-label: slot.number + " " + slot.word;
                        }
                    }
                }
                if root.page.peer-groups != "": VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.page.peer-label;
                        font-size: Type.body-medium;
                        color: Palette.on-surface-variant;
                        wrap: word-wrap;
                        accessible-role: none;
                    }
                    Text {
                        text: root.page.peer-groups;
                        font-family: root.code-font;
                        font-size: Type.body-large;
                        color: Palette.on-surface;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: root.page.peer-label + " " + root.page.peer-groups;
                    }
                }
                if root.page.second-peer-groups != "": VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.page.second-peer-label;
                        font-size: Type.body-medium;
                        color: Palette.on-surface-variant;
                        wrap: word-wrap;
                        accessible-role: none;
                    }
                    Text {
                        text: root.page.second-peer-groups;
                        font-family: root.code-font;
                        font-size: Type.body-large;
                        color: Palette.on-surface;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: root.page.second-peer-label + " " + root.page.second-peer-groups;
                    }
                }
                // R2's phrase so far: four columns of six (section 4.4).
                if root.page.grid.length > 0: GridLayout {
                    spacing: 4px;
                    for slot[i] in root.page.grid: Rectangle {
                        row: floor(i / 4);
                        col: mod(i, 4);
                        min-height: 48px;
                        border-width: slot.current ? 2px : 1px;
                        border-color: slot.current ? Palette.primary : Palette.outline;
                        border-radius: 4px;
                        accessible-role: button;
                        accessible-label: slot.number + (slot.word != "" ? " " + slot.word : "");
                        accessible-action-default => { root.slot(i); }
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: slot.number;
                                font-size: Type.body-small;
                                color: Palette.on-surface-variant;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            Text {
                                text: slot.word;
                                font-size: Type.body-medium;
                                color: Palette.on-surface;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                        TapArea { tapped => { root.slot(i); } }
                    }
                }
            }
        }
        // The picker (section 4): position, letters, suggestions, keypad.
        if root.page.picker: VerticalLayout {
            spacing: 8px;
            Text {
                text: root.page.position;
                font-size: Type.title-small;
                color: Palette.on-surface;
                accessible-role: text;
                accessible-label: self.text;
            }
            // Looks like a field, is not one: no IME ever opens.
            Rectangle {
                height: 52px;
                border-width: 1px;
                border-color: Palette.outline;
                border-radius: 4px;
                Text {
                    x: 12px;
                    text: root.page.typed;
                    font-size: Type.body-large;
                    color: Palette.on-surface;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                min-height: 48px;
                for word in root.page.chips: Rectangle {
                    min-height: 48px;
                    min-width: chip-text.preferred-width + 24px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.outline;
                    background: Palette.surface-container;
                    accessible-role: button;
                    accessible-label: word;
                    accessible-action-default => { root.chip(word); }
                    chip-text := Text {
                        text: word;
                        font-size: Type.body-large;
                        color: Palette.on-surface;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    TapArea { tapped => { root.chip(word); } }
                }
                if root.page.matches != "": Text {
                    text: root.page.matches;
                    font-size: Type.body-medium;
                    color: Palette.on-surface-variant;
                    vertical-alignment: center;
                    accessible-role: text;
                    accessible-label: self.text;
                }
            }
            // QWERTY rows of 10, 9 and 7, or alphabetical sevens when
            // narrower than 340 (section 4.3); keys never move, and every
            // key of a layout is one width.
            keypad := VerticalLayout {
                spacing: 4px;
                property <bool> alphabetical: root.width < 340px;
                property <int> per-row: self.alphabetical ? 7 : 10;
                property <length> key-width: (self.width - (self.per-row - 1) * 4px) / self.per-row;
                for row in (self.alphabetical ? root.page.alpha-rows : root.page.rows): HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    for key in row.keys: Rectangle {
                        width: keypad.key-width;
                        height: 48px;
                        border-radius: 4px;
                        background: Palette.surface-container-high;
                        opacity: key.enabled ? 1.0 : 0.38;
                        accessible-role: button;
                        accessible-label: key.letter;
                        accessible-enabled: key.enabled;
                        accessible-action-default => { if (key.enabled) { root.key(key.letter); } }
                        Text {
                            text: key.letter;
                            font-size: Type.body-large;
                            color: Palette.on-surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        TapArea {
                            enabled: key.enabled;
                            tapped => { root.key(key.letter); }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                ActionButton {
                    text: root.page.key-delete-label;
                    target: 48px;
                    pressed => { root.delete-letter(); }
                }
                ActionButton {
                    text: root.page.key-clear-label;
                    target: 48px;
                    pressed => { root.clear-word(); }
                }
            }
        }
        if root.page.waiting != "": Text {
            text: root.page.waiting;
            font-size: Type.body-large;
            color: Palette.on-surface-variant;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: self.text;
        }
        if root.page.waiting == "" && root.page.primary != "": Rectangle {
            min-height: 48px;
            border-radius: 24px;
            background: !root.page.primary-enabled ? Palette.surface-container-high
                : root.page.primary-danger ? Palette.error : Palette.primary;
            accessible-role: button;
            accessible-label: root.page.primary;
            accessible-enabled: root.page.primary-enabled;
            accessible-action-default => { if (root.page.primary-enabled) { root.primary(); } }
            Text {
                text: root.page.primary;
                font-size: Type.label-large;
                font-weight: 500;
                color: !root.page.primary-enabled ? Palette.on-surface-variant
                    : root.page.primary-danger ? Palette.on-error : Palette.on-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
            TapArea {
                enabled: root.page.primary-enabled;
                tapped => { root.primary(); }
            }
        }
        if root.page.secondary != "": HorizontalLayout {
            alignment: center;
            ActionButton {
                text: root.page.secondary;
                text-button: !root.page.secondary-danger;
                danger: root.page.secondary-danger;
                target: 48px;
                pressed => { root.secondary(); }
            }
        }
        if root.page.tertiary != "": HorizontalLayout {
            alignment: center;
            ActionButton {
                text: root.page.tertiary;
                text-button: true;
                target: 48px;
                pressed => { root.tertiary(); }
            }
        }
        if root.page.footnote != "": Text {
            text: root.page.footnote;
            font-size: Type.body-medium;
            color: Palette.on-surface-variant;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
    }
    // Section 7's dialog: "Continue entering" is the default.
    if root.page.dialog: Rectangle {
        background: #00000080;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 48px, 360px);
            height: dialog-box.preferred-height;
            background: Palette.surface-container-high;
            border-radius: 16px;
            dialog-box := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text {
                    text: root.page.dialog-title;
                    font-size: Type.title-medium;
                    color: Palette.on-surface;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if root.page.dialog-lead != "": Text {
                    text: root.page.dialog-lead;
                    font-size: Type.body-medium;
                    color: Palette.on-surface;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                for item in root.page.dialog-items: HorizontalLayout {
                    spacing: 8px;
                    accessible-role: list-item;
                    accessible-label: item;
                    Text {
                        text: "•";
                        font-size: Type.body-medium;
                        color: Palette.on-surface;
                        accessible-role: none;
                    }
                    Text {
                        text: item;
                        font-size: Type.body-medium;
                        color: Palette.on-surface;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: none;
                    }
                }
                if root.page.dialog-note-a != "": Text {
                    text: root.page.dialog-note-a;
                    font-size: Type.body-medium;
                    color: Palette.on-surface-variant;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if root.page.dialog-note-b != "": Text {
                    text: root.page.dialog-note-b;
                    font-size: Type.body-medium;
                    color: Palette.on-surface-variant;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ActionButton {
                        text: root.page.dialog-delete;
                        text-button: !root.page.dialog-danger;
                        filled: root.page.dialog-danger;
                        danger: root.page.dialog-danger;
                        target: 48px;
                        pressed => { root.dialog(true); }
                    }
                    ActionButton {
                        text: root.page.dialog-keep;
                        text-button: true;
                        target: 48px;
                        focus-seq: root.page.dialog ? 1 : 0;
                        focus-wanted: true;
                        pressed => { root.dialog(false); }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> window-title;
    // The identity screens (Android): shown over everything while active.
    in property <bool> identity-active;
    in property <IdentityPage> identity;
    callback identity-primary();
    callback identity-secondary();
    callback identity-tertiary();
    callback identity-back();
    callback identity-key(string);
    callback identity-delete();
    callback identity-clear();
    callback identity-chip(string);
    callback identity-slot(int);
    callback identity-dialog(bool);
    title: root.window-title;
    // Generated with the rest of the icon set (assets/README.md). winit
    // shows it on X11; a Wayland compositor takes the icon from the app's
    // .desktop entry instead, which packaging/linux does not ship yet. On
    // Android the launcher icon is the manifest's.
    icon: @image-url("assets/interweave-icon-256.png");
    background: Palette.surface;
    preferred-width: 900px;
    preferred-height: 640px;
    // The window's minimum is stated here rather than taken from the panes:
    // reading a Window's size reads the layout it takes its size from, and
    // the panes' widths follow `narrow`, which reads the width -- a binding
    // loop Slint 1.18 warns may panic, and which held a desktop window
    // wider than 600 px whatever it was resized to, so `narrow` was never
    // reached by resizing. 320 px is WCAG 1.4.10's reflow width, the
    // narrowest a layout is expected to work at. The height is the panes'
    // own minimum, as before.
    min-width: 320px;
    min-height: panes.min-height;

    in property <string> conversations-heading;
    in property <string> messages-heading;
    in property <[ConversationRow]> conversations;
    in property <[MessageRow]> messages;
    in property <string> header-title;
    // The full PeerId of a direct conversation, or the channel id (U5a).
    in property <string> header-id;
    // Details' texts: the identifier's label, the route line (empty for
    // none), its two actions.
    in property <string> details-id-label;
    in property <string> details-route;
    in property <string> details-copy-label;
    in property <string> close-label;
    // Copy put the identifier on the clipboard.
    callback identifier-copied();
    // The open direct conversation's route indicator, once the runtime has
    // said; empty for a channel or before it has (human-client-ui.md 7).
    // The open conversation's avatar (section 5.1).
    in property <string> header-avatar-letters;
    in property <int> header-avatar-hue;
    in property <string> more-options-label;
    in property <string> details-label;
    // The overflow menu, and the Details it opens: shown over the window.
    // Rust closes both when another conversation, or none, is shown.
    in-out property <bool> menu-open;
    in-out property <bool> details-open;
    // Bumped when the menu or Details closes, so focus goes back to the
    // overflow button that opened it.
    property <int> menu-closed-seq;
    function close-menu() {
        root.menu-open = false;
        root.details-open = false;
        root.menu-closed-seq += 1;
    }

    // The device's network state: its full text, and Chats' subtitle in
    // short with its icon (#304 F7). A conversation shows it only while
    // offline, as its notice.
    in property <string> connectivity;
    in property <string> state-short;
    in property <Glyph> state-glyph;
    in property <bool> has-notice;
    // A notice about the session itself, the conversation's offline
    // banner excluded: the one a phone's Chats shows too, where the
    // subtitle already says offline.
    in property <bool> has-session-notice;
    in property <string> notice;
    in property <bool> has-notice-action;
    in property <string> notice-action;
    in property <bool> composer-enabled;
    in property <string> composer-label;
    in-out property <string> draft;
    in property <string> refused;
    in property <string> send-label;
    in property <string> show-source-label;
    in property <string> show-formatted-label;
    // The platform's monospaced family, by name: Slint reads a
    // `font-family` as a name, so the generic "monospace" matches nothing.
    in property <string> code-font;
    // The window's one announcement, in two slots that take turns, so
    // the same sentence twice is still a change (rust-ui-dev F4).
    in property <string> announcement-a;
    in property <string> announcement-b;
    // In-out so Rust can clear a stale "undo": nothing reports the Undo
    // losing focus when its snackbar goes.
    in-out property <string> focus-id;

    // The one row a swipe moves ("m:" and an item's handle, "c:" and a
    // conversation's), how far, whether it is armed, and whether it
    // follows the finger now -- set by Rust, which decides the gesture
    // (gesture.rs), from the positions the rows report.
    in property <string> swipe-key;
    in property <length> swipe-offset;
    in property <bool> swipe-armed;
    in property <bool> swipe-tracking;
    // A right-to-left layout: the swipe directions mirror.
    in property <bool> rtl;
    // The system's animations are off: nothing animates.
    in property <bool> reduced-motion;
    // A focus request: Rust bumps the sequence once the rows it names are
    // drawn, and the control named by the target takes focus ("m:" and an
    // item's handle, "c:" and a conversation's, "h" the open
    // conversation's header title, "heading" the list's heading).
    // Set by the view, and by the trust dialog's own Tab, which keeps
    // focus on its two buttons.
    in-out property <int> focus-seq;
    in-out property <string> focus-target;
    // The snackbar (swipe spec section 6): one at a time, in the
    // conversation above the composer, or on the conversation list.
    // Rust clears it when an input that closes the snackbar is queued, so
    // no Undo can be pressed on screen for one the queue has closed.
    in property <bool> snack-shown;
    in property <bool> snack-on-list;
    in property <int> snack-id;
    in property <string> snack-text;
    in property <bool> snack-undo;
    in property <string> undo-label;
    // The open conversation's "Hide conversation", when it is offered.
    in property <bool> hide-conversation-shown;
    in property <string> hide-conversation-label;

    // The trust settings (human-client-ui.md section 8), shown in place of
    // the conversation: every string from Rust, every press back to it.
    in property <bool> trust-page;
    // Android: Settings offers the recovery phrase under the PeerId
    // (design/2026-10-19-android-identity.md section 3.5).
    in property <bool> show-phrase-offered;
    in property <string> show-phrase-label;
    // The Chats bar's overflow (#304 F12): the app's options, named apart
    // from a conversation's "More options" since both show side by side
    // on a wide window. Trust and Peers are its entries.
    in property <string> app-options-label;
    // The list pane's width, which the app's options menu is placed by.
    property <length> list-width: root.list-aside ? 0px
        : !root.narrow ? 280px
        : root.list-shown ? root.width - root.safe-area-insets.left - root.safe-area-insets.right
        : 0px;
    in-out property <bool> chats-menu-open;
    // Bumped when the menu closes or Trust is left: focus goes back to
    // the button.
    property <int> chats-menu-closed-seq;
    function close-chats-menu() {
        root.chats-menu-open = false;
        root.chats-menu-closed-seq += 1;
    }
    in property <string> back-label;
    in property <string> trust-heading;
    in property <string> trust-explanation;
    in property <string> own-peer-id-label;
    in property <string> own-peer-id;
    in property <string> trusted-heading;
    // Said in place of the list: reading it, or that it holds no peer.
    in property <string> trust-placeholder;
    // The entry's own problem ("not a PeerId"), shown under its field
    // rather than with the other outcomes.
    in property <string> entry-error;
    in property <[TrustRow]> trusted;
    // The allowlist has been read: only then can a typed PeerId be
    // checked, so only then is the add row offered.
    in property <bool> trust-list-read;
    in property <string> remove-label;
    in property <string> entry-label;
    in-out property <string> trust-entry;
    in property <string> add-label;
    in property <bool> has-pending;
    in property <string> pending-text;
    in property <string> confirm-label;
    in property <string> cancel-label;
    // The last outcome, shown where it happened; announced through the
    // window's one announcement.
    in property <string> trust-outcome;

    // Peers by address (design/2026-10-22-add-a-peer.md): shown in place of
    // the conversation as the trust settings are, every string from Rust
    // and every press back to it.
    in property <bool> peers-page;
    in property <string> peers-title;
    // In place of the list: why it cannot be read, and whether Try again
    // is offered.
    in property <string> peers-problem;
    in property <bool> peers-problem-retry;
    in property <string> try-again-label;
    // The list has been read: only then are the rows and Add shown.
    in property <bool> peers-list-read;
    in property <string> add-address-label;
    // Under Add an address: why it opened nothing.
    in property <string> peers-add-note;
    in property <string> peers-no-trust;
    // The trust list is not the daemon's word (section 5.2's trust
    // unread): the line in peers-no-trust's place, and whether Try again
    // is offered.
    in property <string> peers-trust-line;
    in property <bool> peers-trust-retry;
    in property <string> peers-empty;
    in property <[PeerAddressRow]> peer-rows;
    in property <string> copy-address-label;
    in property <string> remove-address-label;
    in property <string> not-removable-label;
    in property <string> trust-this-label;
    // A row's menu open, by handle, or -1.
    in-out property <int> peer-menu: -1;
    // What Copy address copies, set by the press. Never shown.
    in-out property <string> copy-text;
    // The add page (section 5.3), in Peers' place.
    in property <bool> peers-add-open;
    in property <string> add-title;
    in property <string> address-field-label;
    in property <string> address-help;
    in-out property <string> address-text;
    // The field's lines to select, as character offsets, applied at each
    // new sequence once the field has focus: a refused line.
    in property <int> address-select-from;
    in property <int> address-select-to;
    in property <int> address-select-seq;
    // The scan controls this platform offers: the camera on Android,
    // an image file or a pasted one on the desktop.
    in property <bool> scan-camera;
    in property <bool> scan-images;
    in property <string> scan-code-label;
    in property <string> open-image-label;
    in property <string> paste-image-label;
    in property <string> add-action-label;
    // The page's one note: under the field, under the scan controls, or
    // under Add, by what it is about.
    in property <string> field-note;
    in property <string> scan-note;
    in property <string> add-note;
    // Step one's result, once done: the field and its controls give way to
    // it, and step two appears under it.
    // Step one -- the field, its helper and Add -- is on show: the add
    // page with no result and no trust block (a row's Trust opens the
    // trust step alone).
    in property <bool> add-step-one;
    in property <string> add-result;
    in property <[PeerTrustBlock]> trust-blocks;
    in property <string> trust-step-body;
    in property <string> trust-step-both;
    in property <string> not-now-label;
    in property <string> copy-peer-id-label;
    in property <bool> blocks-done-shown;
    in property <string> done-label;
    // Peers' snackbar: one at a time, its action Undo or Try again.
    in property <bool> peers-snack-shown;
    in property <int> peers-snack-id;
    in property <string> peers-snack-text;
    in property <bool> peers-snack-action-shown;
    in property <string> peers-snack-action;
    // Chats' no-reach notice (section 5.6): a state, not news, so it has
    // no Close; its action opens Peers.
    in property <bool> no-reach-shown;
    in property <string> no-reach-text;

    callback select(int);
    callback action(int, int);
    // One haptic tick as a long-press opens a message's menu.
    callback menu-haptic();
    // The message whose menu is open, by its handle, or -1, with what the
    // menu shows: the row's actions as rendered, Show source's label, the
    // message's label, and the bubble it is anchored to.
    in-out property <int> row-menu: -1;
    property <[ActionRow]> row-menu-actions;
    property <string> row-menu-source;
    property <string> row-menu-detail;
    property <length> row-menu-x;
    property <length> row-menu-y;
    property <length> row-menu-w;
    property <length> row-menu-h;
    // Show source chosen from a menu, for the row that keeps the choice.
    property <int> source-toggle: -1;
    property <int> source-toggle-seq;
    function open-row-menu(handle: int, actions: [ActionRow], source: string, detail: string,
        x: length, y: length, w: length, h: length) {
        root.row-menu-actions = actions;
        root.row-menu-source = source;
        root.row-menu-detail = detail;
        root.row-menu-x = x;
        root.row-menu-y = y;
        root.row-menu-w = w;
        root.row-menu-h = h;
        root.row-menu = handle;
    }
    // Closed with nothing done (Escape, Back, a tap outside): focus back
    // on its bubble.
    public function close-row-menu() {
        if (root.row-menu < 0) { return; }
        root.focus-target = "m:" + root.row-menu;
        root.row-menu = -1;
        root.focus-seq += 1;
    }
    callback link(int, int);
    callback send();
    callback notice-pressed();
    callback draft-edited(string);
    callback open-trust();
    callback show-phrase();
    callback close-trust();
    callback trust-entry-edited(string);
    callback trust-add();
    callback trust-remove(int);
    callback trust-confirm();
    callback trust-cancel();
    callback open-peers();
    callback close-peers();
    callback peers-read-again();
    callback peers-trust-read-again();
    callback peers-open-add();
    callback peers-add-closed();
    callback address-edited(string);
    callback peers-add();
    callback peers-scan();
    callback peers-open-image();
    callback peers-paste-image();
    callback block-trust(int);
    callback block-not-now(int);
    callback peers-done();
    callback row-trust(int);
    callback row-remove(int);
    callback peers-snack-pressed(int);
    callback peers-snack-closed(int);
    // A row's swipe: the press and the current position, in window
    // coordinates, and the row's width; then its end or its cancel.
    callback swipe-moved(string, length, length, length, length, length, length);
    callback swipe-ended(string);
    callback swipe-cancelled(string);
    callback undo(int);
    callback snack-closed(int);
    callback hide-conversation();
    // The right-hand pane was shown or hidden: a narrow window went to
    // the list or back, or a resize crossed `narrow` (`pane-shown`).
    callback pane-changed();
    // A narrow window's Back: the person left the conversation, even if a
    // pick from the list shows it again before the window's next turn,
    // when `pane-shown` is back where it was.
