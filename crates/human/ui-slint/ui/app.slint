                    entry := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: self.preferred-height;
                        y: (parent.height - self.height) / 2;
                        font-size: Type.body-large;
                        color: Palette.on-surface;
                        vertical-alignment: center;
                        single-line: true;
                        text <=> root.trust-entry;
                        accessible-label: root.entry-label;
                        edited => { root.trust-entry-edited(self.text); }
                        changed has-focus => {
                            if (self.has-focus) { root.focus-id = "trust-entry"; }
                        }
                    }
                    FocusRing {
                        x: -5px;
                        y: -5px;
                        width: entry-box.width + 10px;
                        height: entry-box.height + 10px;
                        shown: entry.has-focus;
                    }
                }
                if entry-row.beside: VerticalLayout {
                    alignment: center;
                    ActionButton {
                        text: root.add-label;
                        filled: true;
                        target: 48px;
                        focus-key: "trust-add";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "trust-add";
                        pressed => { root.trust-add(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
            }
                // The entry's error, under the field it is about.
                if root.entry-error != "": Text {
                    text: root.entry-error;
                    color: Palette.error;
                    font-size: Type.body-small;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if !entry-row.beside: HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: root.add-label;
                        filled: true;
                        target: 48px;
                        focus-key: "trust-add";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "trust-add";
                        pressed => { root.trust-add(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
            }
            // Where focus goes once the last row it could go to is gone.
            FocusHeading {
                text: root.trusted-heading;
                font-size: Type.title-small;
                rtl: root.rtl;
                focus-key: "trusted-heading";
                focus-seq: root.focus-seq;
                focus-wanted: root.focus-target == "trusted-heading";
                focused(k) => { root.focus-id = k; }
            }
            if root.trust-placeholder != "": Text {
                text: root.trust-placeholder;
                color: Palette.on-surface-variant;
                accessible-role: text;
                accessible-label: self.text;
            }
            Flickable {
                vertical-stretch: 1;
                content-height: trusted-column.preferred-height;
            trusted-column := VerticalLayout {
                width: parent.width;
                spacing: 6px;
                // Room for a control's focus ring, which the list would clip.
                padding: 5px;
                alignment: start;
            for row[index] in root.trusted: HorizontalLayout {
                spacing: 8px;
                // The exact PeerId: whole, never shortened, so a person can
                // check every character (human-client-ui.md section 8).
                // Where the row comes from goes UNDER the PeerId, never
                // beside it: the full PeerId already takes the width, and a
                // narrow window must still reach every row's control.
                VerticalLayout {
                    horizontal-stretch: 1;
                    // The PeerId's focus ring clears the line under it.
                    spacing: 5px;
                    peer-box := Rectangle {
                        // Its field's height: a box in a layout stretches without one, and
                        // the field alone does not size it (both seen in the window).
                        height: peer-input.preferred-height;
                        peer-input := TextInput {
                            text: row.peer;
                            read-only: true;
                            // As this profile's own: whole, in the code font.
                            single-line: false;
                            wrap: char-wrap;
                            font-family: root.code-font;
                            accessible-label: row.peer;
                            accessible-value: self.text;
                            changed has-focus => {
                                if (self.has-focus) { root.focus-id = "peer:" + row.handle; }
                            }
                        }
                        FocusRing {
                            x: -5px;
                            y: -5px;
                            width: peer-box.width + 10px;
                            height: peer-box.height + 10px;
                            shown: peer-input.has-focus;
                        }
                    }
                    Text {
                        text: row.origin;
                        color: Palette.on-surface-variant;
                        // Wrapped: unwrapped, its whole width was the
                        // column's minimum, which pushed Remove trust past
                        // the window's edge in a wider font (CI's DejaVu).
                        wrap: word-wrap;
                    }
                }
                // A text button in the error colour, at a 48 target, on
                // every row: the one place trust is taken back.
                ActionButton {
                    text: root.remove-label;
                    detail: row.peer;
                    text-button: true;
                    ink: Palette.error;
                    target: 48px;
                    focus-key: "remove:" + row.handle;
                    focus-seq: root.focus-seq;
                    focus-wanted: root.focus-target == "remove:" + row.handle;
                    pressed => { root.trust-remove(row.handle); }
                    focused(k) => { root.focus-id = k; }
                }
            }
            }
            }
            if root.trust-outcome != "": Text {
                text: root.trust-outcome;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: self.text;
            }
        }
        if root.peers-page: peers-pane := VerticalLayout {
            visible: root.pane-shown;
            padding: 12px;
            spacing: 8px;
            // The top app bar, as Trust's: the back arrow at the line's
            // start and the screen's title, which takes focus when Peers
            // opens. The add page's back arrow is its Close.
            HorizontalLayout {
                min-height: 64px;
                spacing: 8px;
                if !root.rtl: VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: Glyph.back;
                        rtl: root.rtl;
                        ink: Palette.on-surface;
                        label: root.back-label;
                        focus-key: "close-peers";
                        pressed => {
                            if (root.peers-add-open) { root.peers-add-closed(); } else { root.close-peers-page(); }
                        }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    FocusHeading {
                        text: root.peers-add-open ? root.add-title : root.peers-title;
                        font-size: Type.title-large;
                        font-weight: 400;
                        rtl: root.rtl;
                        focus-key: "peers-title";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "peers-title";
                        focused(k) => { root.focus-id = k; }
                    }
                }
                if root.rtl: VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: Glyph.back;
                        rtl: root.rtl;
                        ink: Palette.on-surface;
                        label: root.back-label;
                        focus-key: "close-peers";
                        pressed => {
                            if (root.peers-add-open) { root.peers-add-closed(); } else { root.close-peers-page(); }
                        }
                        focused(k) => { root.focus-id = k; }
                    }
                }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: peers-column.preferred-height;
            peers-column := VerticalLayout {
                width: parent.width;
                // Room for a control's focus ring, which the list would clip.
                padding: 5px;
                spacing: 12px;
                alignment: start;
                // The list unreadable (section 5.7): its line and, where a
                // retry can mend it, Try again; no Add, no rows.
                if !root.peers-add-open && root.peers-problem != "": FocusNote {
                    text: root.peers-problem;
                    rtl: root.rtl;
                    focus-key: "peers-problem";
                    focus-seq: root.focus-seq;
                    focus-wanted: root.focus-target == "peers-problem";
                    focused(k) => { root.focus-id = k; }
                }
                if !root.peers-add-open && root.peers-problem != "" && root.peers-problem-retry: HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: root.try-again-label;
                        target: 48px;
                        focus-key: "peers-retry";
                        pressed => { root.peers-read-again(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                if !root.peers-add-open && root.peers-list-read: HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: root.add-address-label;
                        filled: true;
                        target: 48px;
                        focus-key: "add-address";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "add-address";
                        pressed => { root.peers-open-add(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                // At the bound, or with the list off: why Add an address
                // opened nothing, focus on it.
                if !root.peers-add-open && root.peers-add-note != "": FocusNote {
                    text: root.peers-add-note;
                    rtl: root.rtl;
                    focus-key: "add-address-note";
                    focus-seq: root.focus-seq;
                    focus-wanted: root.focus-target == "add-address-note";
                    focused(k) => { root.focus-id = k; }
                }
                if !root.peers-add-open && root.peers-list-read && root.peers-trust-line != "": FocusNote {
                    text: root.peers-trust-line;
                    rtl: root.rtl;
                    focus-key: "trust-line";
                    focus-seq: root.focus-seq;
                    focus-wanted: root.focus-target == "trust-line";
                    focused(k) => { root.focus-id = k; }
                }
                if !root.peers-add-open && root.peers-list-read && root.peers-trust-line != "" && root.peers-trust-retry: HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: root.try-again-label;
                        target: 48px;
                        focus-key: "trust-retry";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "trust-retry";
                        pressed => { root.peers-trust-read-again(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                if !root.peers-add-open && root.peers-list-read && root.peers-trust-line == "": Text {
                    text: root.peers-no-trust;
                    wrap: word-wrap;
                    min-width: 0;
                    color: Palette.on-surface-variant;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if !root.peers-add-open && root.peers-empty != "": Text {
                    text: root.peers-empty;
                    wrap: word-wrap;
                    min-width: 0;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if !root.peers-add-open: VerticalLayout {
                    spacing: 12px;
                for row[index] in root.peer-rows: VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        // Read as one item, its peer first: who, where, and
                        // what this device does with it.
                        peer-row := FocusScope {
                            horizontal-stretch: 1;
                            focus-gained(reason) => {
                                if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
                                if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
                            }
                            property <int> focus-seq: root.focus-seq;
                            changed focus-seq => {
                                if (root.focus-target == "row:" + row.handle) { self.focus(); }
                            }
                            changed has-focus => {
                                if (self.has-focus) { root.focus-id = "row:" + row.handle; }
                            }
                            accessible-role: text;
                            accessible-label: row.peer;
                            accessible-description: row.state == "" ? row.host + ". " + row.origin : row.host + ". " + row.state + ". " + row.origin;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: row.peer;
                                    font-size: Type.title-small;
                                    font-weight: 500;
                                    accessible-role: none;
                                }
                                Text {
                                    text: row.host;
                                    font-family: root.code-font;
                                    font-size: Type.body-medium;
                                    wrap: char-wrap;
                                    color: Palette.on-surface-variant;
                                    accessible-role: none;
                                }
                                if row.state != "": Text {
                                    text: row.state;
                                    font-size: Type.body-medium;
                                    wrap: word-wrap;
                                    min-width: 0;
                                    accessible-role: none;
                                }
                                Text {
                                    text: row.origin;
                                    font-size: Type.body-small;
                                    wrap: word-wrap;
                                    min-width: 0;
                                    color: Palette.on-surface-variant;
                                    accessible-role: none;
                                }
                            }
                            FocusRing {
                                x: -5px;
                                y: -5px;
                                width: peer-row.width + 10px;
                                height: peer-row.height + 10px;
                                shown: peer-row.has-focus;
                            }
                        }
                        if row.needs-trust: VerticalLayout {
                            alignment: center;
                            ActionButton {
                                text: root.trust-this-label;
                                detail: row.peer;
                                text-button: true;
                                target: 48px;
                                focus-key: "row-trust:" + row.handle;
                                focus-seq: root.focus-seq;
                                focus-wanted: root.focus-target == "row-trust:" + row.handle;
                                pressed => { root.row-trust(row.handle); }
                                focused(k) => { root.focus-id = k; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                glyph: Glyph.more;
                                label: row.menu-label;
                                focus-key: "row-menu:" + row.handle;
                                focus-seq: root.focus-seq;
                                focus-wanted: root.focus-target == "row-menu:" + row.handle;
                                pressed => {
                                    root.peer-menu = root.peer-menu == row.handle ? -1 : row.handle;
                                }
                                focused(k) => { root.focus-id = k; }
                            }
                        }
                    }
                    // The row's menu, under it: Copy address, and Remove on
                    // an added row or why not on a configuration row.
                    if root.peer-menu == row.handle: VerticalLayout {
                        MenuItem {
                            text: root.copy-address-label;
                            detail: row.peer;
                            focus-key: "row-copy:" + row.handle;
                            first: true;
                            rtl: root.rtl;
                            pressed => {
                                root.copy-text = row.address;
                                peers-copy.select-all();
                                peers-copy.copy();
                                peers-copy.clear-selection();
                                root.peer-menu = -1;
                                root.focus-target = "row-menu:" + row.handle;
                                root.focus-seq += 1;
                            }
                            closed => {
                                root.peer-menu = -1;
                                root.focus-target = "row-menu:" + row.handle;
                                root.focus-seq += 1;
                            }
                            focused(k) => { root.focus-id = k; }
                        }
                        if row.removable: MenuItem {
                            text: root.remove-address-label;
                            detail: row.peer;
                            focus-key: "row-remove:" + row.handle;
                            rtl: root.rtl;
                            pressed => {
                                root.peer-menu = -1;
                                root.row-remove(row.handle);
                            }
                            closed => {
                                root.peer-menu = -1;
                                root.focus-target = "row-menu:" + row.handle;
                                root.focus-seq += 1;
                            }
                            focused(k) => { root.focus-id = k; }
                        }
                        if !row.removable: Text {
                            text: root.not-removable-label;
                            wrap: word-wrap;
                            min-width: 0;
                            color: Palette.on-surface-variant;
                            accessible-role: text;
                            accessible-label: self.text;
                        }
                    }
                }
                }
                // The add page, step one: the field, its helper, the scan
                // controls this platform offers, Add, and the page's note
                // where it is about.
                if root.add-step-one: Text {
                    text: root.address-field-label;
                    font-size: Type.body-small;
                    font-weight: 700;
                    accessible-role: none;
                }
                if root.add-step-one: address-box := Rectangle {
                    height: max(96px, address-input.preferred-height + 24px);
                    border-width: address-input.has-focus || root.field-note != "" ? 2px : 1px;
                    border-color: root.field-note != "" ? Palette.error
                        : address-input.has-focus ? Palette.primary : Palette.outline;
                    border-radius: 4px;
                    address-input := TextInput {
                        x: 16px;
                        y: 12px;
                        width: parent.width - 32px;
                        height: parent.height - 24px;
                        // A pasted list of lines is a list: line breaks are
                        // kept, each line checked on its own (section 5.3).
                        single-line: false;
                        wrap: char-wrap;
                        font-family: root.code-font;
                        font-size: Type.body-medium;
                        color: Palette.on-surface;
                        text <=> root.address-text;
                        accessible-label: root.address-field-label;
                        accessible-description: root.field-note;
                        edited => { root.address-edited(self.text); }
                        changed has-focus => {
                            if (self.has-focus) { root.focus-id = "address-field"; }
                        }
                        property <int> focus-seq: root.focus-seq;
                        changed focus-seq => {
                            if (root.focus-target == "address-field") { self.focus(); }
                        }
                        property <int> select-seq: root.address-select-seq;
                        changed select-seq => {
                            self.set-selection-offsets(root.address-select-from, root.address-select-to);
                        }
                    }
                    FocusRing {
                        x: -5px;
                        y: -5px;
                        width: address-box.width + 10px;
                        height: address-box.height + 10px;
                        shown: address-input.has-focus;
                    }
                }
                if root.add-step-one && root.field-note != "": Text {
                    text: root.field-note;
                    color: Palette.error;
                    font-size: Type.body-small;
                    wrap: word-wrap;
                    min-width: 0;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if root.add-step-one: Text {
                    text: root.address-help;
                    font-size: Type.body-small;
                    wrap: word-wrap;
                    min-width: 0;
                    color: Palette.on-surface-variant;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if root.add-step-one && (root.scan-camera || root.scan-images): HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    if root.scan-camera: ActionButton {
                        text: root.scan-code-label;
                        target: 48px;
                        focus-key: "scan-code";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "scan-code";
                        pressed => { root.peers-scan(); }
                        focused(k) => { root.focus-id = k; }
                    }
                    if root.scan-images: ActionButton {
                        text: root.open-image-label;
                        target: 48px;
                        focus-key: "open-image";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "open-image";
                        pressed => { root.peers-open-image(); }
                        focused(k) => { root.focus-id = k; }
                    }
                    if root.scan-images: ActionButton {
                        text: root.paste-image-label;
                        target: 48px;
                        focus-key: "paste-image";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "paste-image";
                        pressed => { root.peers-paste-image(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                // About the scan controls: read after them, focus on it.
                if root.add-step-one && root.scan-note != "": FocusNote {
                    text: root.scan-note;
                    rtl: root.rtl;
                    focus-key: "add-page-note";
                    focus-seq: root.focus-seq;
                    focus-wanted: root.focus-target == "add-page-note";
                    focused(k) => { root.focus-id = k; }
                }
                if root.add-step-one: HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: root.add-action-label;
                        filled: true;
                        target: 48px;
                        focus-key: "add-action";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "add-action";
                        pressed => { root.peers-add(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                if root.add-step-one && root.add-note != "": Text {
                    text: root.add-note;
                    font-size: Type.body-medium;
                    wrap: word-wrap;
                    min-width: 0;
                    accessible-role: text;
                    accessible-label: self.text;
                    accessible-live-region: polite;
                }
                // Step one done: one line naming what was added, then step
                // two, one block per PeerId not trusted yet.
                if root.peers-add-open && root.add-result != "": Text {
                    text: root.add-result;
                    wrap: word-wrap;
                    min-width: 0;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if root.peers-add-open: VerticalLayout {
                    spacing: 16px;
                for block[index] in root.trust-blocks: VerticalLayout {
                    spacing: 8px;
                    FocusNote {
                        text: block.title;
                        font-size: Type.title-medium;
                        font-weight: 700;
                        rtl: root.rtl;
                        focus-key: "block:" + block.handle;
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "block:" + block.handle;
                        focused(k) => { root.focus-id = k; }
                    }
                    // The full PeerId in the code font, whole, never cut:
                    // the characters the person compares.
                    Text {
                        text: block.peer;
                        font-family: root.code-font;
                        font-size: Type.body-medium;
                        wrap: char-wrap;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    HorizontalLayout {
                        alignment: start;
                        ActionButton {
                            text: root.copy-peer-id-label;
                            detail: block.peer;
                            text-button: true;
                            target: 48px;
                            focus-key: "block-copy:" + block.handle;
                            pressed => {
                                root.copy-text = block.peer;
                                peers-copy.select-all();
                                peers-copy.copy();
                                peers-copy.clear-selection();
                            }
                            focused(k) => { root.focus-id = k; }
                        }
                    }
                    Text {
                        text: root.trust-step-body;
                        wrap: word-wrap;
                        min-width: 0;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    Text {
                        text: root.trust-step-both;
                        wrap: word-wrap;
                        min-width: 0;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    if block.undecided: HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        if block.trust-offered: ActionButton {
                            text: root.trust-this-label;
                            detail: block.peer;
                            filled: true;
                            target: 48px;
                            focus-key: "block-trust:" + block.handle;
                            pressed => { root.block-trust(block.handle); }
                            focused(k) => { root.focus-id = k; }
                        }
                        ActionButton {
                            text: root.not-now-label;
                            detail: block.peer;
                            text-button: true;
                            target: 48px;
                            focus-key: "block-later:" + block.handle;
                            pressed => { root.block-not-now(block.handle); }
                            focused(k) => { root.focus-id = k; }
                        }
                    }
                    if block.problem != "": FocusNote {
                        text: block.problem;
                        rtl: root.rtl;
                        focus-key: "block-problem:" + block.handle;
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "block-problem:" + block.handle;
                        focused(k) => { root.focus-id = k; }
                    }
                    if block.state != "": Text {
                        text: block.state;
                        font-weight: 500;
                        wrap: word-wrap;
                        min-width: 0;
                        accessible-role: text;
                        accessible-label: self.text;
                        accessible-live-region: polite;
                    }
                }
                }
                if root.peers-add-open && root.blocks-done-shown: HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: root.done-label;
                        target: 48px;
                        focus-key: "peers-done";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "peers-done";
                        pressed => { root.peers-done(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
            }
            }
            if root.peers-snack-shown: Snackbar {
                text: root.peers-snack-text;
                undo: root.peers-snack-action-shown;
                undo-label: root.peers-snack-action;
                snack-id: root.peers-snack-id;
                focus-seq: root.focus-seq;
                rtl: root.rtl;
                undo-pressed(id) => { root.peers-snack-pressed(id); }
                dismissed(id) => { root.peers-snack-closed(id); }
                focused(k) => { root.focus-id = k; }
            }
        }
        if !root.trust-page && !root.peers-page: VerticalLayout {
            visible: root.pane-shown;
            padding: 12px;
            // With the app bar aside, the list begins at the pane's top: the
            // padding was there to set the bar off the window's edge, and
            // the strip left to the messages has no 12 px to spare
            // (#304 F9 step 5).
            padding-top: root.bar-aside ? 0px : 12px;
            spacing: 8px;
            // The top app bar (section 6): Back on a narrow screen, the
            // avatar, the name over the connectivity line and, once known,
            // the path line, and the overflow menu. The identifier is in
            // Details, no longer on the screen itself.
            if !root.bar-aside: HorizontalLayout {
                min-height: 64px;
                spacing: 8px;
                init => { root.bar-height = self.height; }
                changed height => { root.bar-height = self.height; }
                // A layout has no direction of its own: right to left, the
                // children come in the mirrored order, so Back sits at the
                // line's start on the right and More at its end on the left
                // (section 7), where its menu opens.
                if root.narrow && !root.rtl: VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: Glyph.back;
                        rtl: root.rtl;
                        ink: Palette.on-surface;
                        label: root.back-label;
                        focus-key: "back-to-list";
                        pressed => {
                            root.list-shown = true;
                            root.left-conversation();
                        }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                if root.header-id != "" && !root.rtl: VerticalLayout {
                    alignment: center;
                    Avatar {
                        size: 36px;
                        letters: root.header-avatar-letters;
                        hue: root.header-avatar-hue;
                    }
                }
                if root.header-id != "" && root.rtl: VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: Glyph.more;
                        label: root.more-options-label;
                        focus-key: "more-options";
                        focus-seq: root.menu-closed-seq;
                        focus-wanted: true;
                        pressed => { root.menu-open = true; }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    FocusHeading {
                        text: root.header-title;
                        // The full PeerId or channel id, as a screen reader
                        // reads it (U5a); shown in Details.
                        description: root.header-id;
                        font-size: Type.title-medium;
                        font-weight: 500;
                        rtl: root.rtl;
                        focus-key: "header-title";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "h";
                        focused(k) => { root.focus-id = k; }
                    }
                }
                if root.header-id != "" && !root.rtl: VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: Glyph.more;
                        label: root.more-options-label;
                        focus-key: "more-options";
                        focus-seq: root.menu-closed-seq;
                        focus-wanted: true;
                        pressed => { root.menu-open = true; }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                if root.header-id != "" && root.rtl: VerticalLayout {
                    alignment: center;
                    Avatar {
                        size: 36px;
                        letters: root.header-avatar-letters;
                        hue: root.header-avatar-hue;
                    }
                }
                if root.narrow && root.rtl: VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: Glyph.back;
                        rtl: root.rtl;
                        ink: Palette.on-surface;
                        label: root.back-label;
                        focus-key: "back-to-list";
                        pressed => {
                            root.list-shown = true;
                            root.left-conversation();
                        }
                        focused(k) => { root.focus-id = k; }
                    }
                }
            }
            if root.has-notice && !root.notice-aside: NoticeCard {
                message: root.notice;
                has-action: root.has-notice-action;
                action: root.notice-action;
                init => { root.notice-height = self.height; }
                changed height => { root.notice-height = self.height; }
                pressed => { root.notice-pressed(); }
                focused(k) => { root.focus-id = k; }
            }
            // The list, and over its top corner its heading. The heading is
            // placed, so it is not a row of the pane and costs it no spacing:
            // with the keyboard up in landscape the strip left to the
            // messages is the pane's height less its chrome, and an empty
            // row's 8 px were a fifth of it (#304 F9 step 5).
            Rectangle {
                vertical-stretch: 1;
            // Not drawn: the bubbles show where the messages are. Kept as a
            // heading a screen reader can move to (section 6), clipped to
            // a point rather than hidden, which would take it out of the
            // tree.
                Rectangle {
                    x: 0;
                    y: 0;
                    width: 1px;
                    height: 1px;
                    clip: true;
                    Text {
                        text: root.messages-heading;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                }
            // A long conversation scrolls; the composer stays in view. The
            // built-in Flickable, not std-widgets' ScrollView, whose icons
            // need an image feature the graph does not carry: it scrolls
            // by wheel and touch, with no visible scrollbar.
            Flickable {
                width: parent.width;
                height: parent.height;
                content-height: messages-column.preferred-height;
                // A row tracking a swipe holds its touch: the list does
                // not scroll for it (swipe spec section 4).
                interactive: !root.swipe-tracking;
                // While the keyboard is up the list is anchored at its
                // newest message, whatever space it keeps: as the keyboard
                // opens, as the space changes, as a message arrives (#304
                // F9 step 5).
                // The content's height can lag the change a turn (read
                // early it is the padding alone); its own change anchors
                // again, so the list settles at its newest message.
                function to-newest() {
                    self.content-y = min(0px, self.height - self.content-height);
                }
                // Pinned to its end while it shows its end: a conversation
                // opens at its end and stays there as its space or its
                // messages change (the spec's S3). Whatever moves it away
                // -- a scroll, a drag, or the toolkit bringing a focused
                // message into view, which fires no `flicked` -- unpins it,
                // and a new message then leaves it where it is; back at its
                // end it is pinned again. A clamp after a resize lands at
                // the end, so it keeps the pin. The pane's list is shared
                // by every conversation, so a change of conversation pins
                // it again.
                property <bool> pinned: true;
                changed content-y => {
                    self.pinned = self.content-y <= self.height - self.content-height + 1px;
                }
                property <string> shown: root.header-id;
                changed shown => {
                    self.pinned = true;
                    self.to-newest();
                }
                property <bool> anchored: root.typing || self.pinned;
                init => { self.to-newest(); }
                changed anchored => {
                    if (self.anchored) { self.to-newest(); }
                }
                changed height => {
                    if (self.anchored) { self.to-newest(); }
                }
                property <length> content: self.content-height;
                changed content => {
                    if (self.anchored) { self.to-newest(); }
                }
            messages-column := VerticalLayout {
                width: parent.width;
                // The space between rows is each row's gap (section 6: 2 px
                // within a run, 8 px between runs), and none of the list's:
                // a closed row would otherwise keep its share until removed.
                spacing: 0px;
                // Room for a row's focus ring, which the list would clip.
                padding: 5px;
                alignment: start;
            // The space above it is section 6's: 2 px within a run, 8 px
            // between runs.
            // The whole row -- its gap, its day separator and its item --
            // closes as it leaves: held at the height it had, then closed
            // to nothing, unless it hands its day's separator over to the
            // row after it (after its run, when rows leave together), when
            // only its item closes (swipe spec section 5;
            // tests/look.rs, `a_leaving_message_closes_its_space_without_a_jump`).
            // Clipped so it hides what it covered.
            for row[index] in root.messages: row-box := Rectangle {

                // Clipped only while it closes: a clipped row is skipped when
                // focus moves to rows outside the window, so a long list
                // could not be tabbed through
                // (`a_long_conversation_brings_the_focused_message_into_view`).
                clip: row.leaving;
                // A leaving row takes no minimum from its content, or its
                // closing maximum would lose to it and it would never close.
                // Any other row keeps its content's, so a long list scrolls
                // rather than squeezing its rows into the window.
                min-height: row.leaving ? 0px : row-content.min-height;
                property <bool> collapsing: false;
                // Held at its content's height, read from the content rather
                // than kept by a change handler, which runs a turn late: a
                // row leaving before it ran closed in one frame.
                max-height: !row.leaving ? 100000px
                    : !self.collapsing ? row-content.preferred-height
                    : row.hand-over ? row.gap + day-measure.preferred-height + 4px
                    : 0px;
                animate max-height {
                    duration: self.collapsing && !root.reduced-motion ? 150ms : 0ms;
                    easing: ease-out;
                }
                Timer {
                    interval: 16ms;
                    running: row.leaving && !row-box.collapsing;
                    triggered => { row-box.collapsing = true; }
                }
                // The separator's height, measured: what a handed-over row
                // keeps of itself while its item closes.
                day-measure := Text {
                    x: 0;
                    y: 0;
                    text: row.day;
                    font-size: Type.body-small;
                    visible: false;
                    accessible-role: none;
                }
            row-content := VerticalLayout {
                padding-top: row.gap;
                spacing: 4px;
                // A day change: "Today", "Yesterday", a weekday or the date,
                // centred -- outside the message's item, so a screen reader
                // reaches it as an item of its own before the run it heads
                // (sections 6 and 9).
                // A leaving row's separator closes with it, unread, unless it
                // hands it over: then it stays, the day's one separator.
                if row.day != "" && (!row.leaving || row.hand-over): Text {
                    text: row.day;
                    font-size: Type.body-small;
                    color: Palette.on-surface-variant;
                    horizontal-alignment: center;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if row.day != "" && row.leaving && !row.hand-over: Text {
                    text: row.day;
                    font-size: Type.body-small;
                    color: Palette.on-surface-variant;
                    horizontal-alignment: center;
                    accessible-role: none;
                }
                item := FocusScope {
                    focus-gained(reason) => {
                        if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
                        if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
                    }
                    // The person's choice for this message, kept with its row
                    // while the row exists: the drawn body, or the source.
                    in-out property <bool> show-source: false;
                    property <string> swipe-key: "m:" + row.handle;
                    // How far the row's content sits from rest: the swipe's,
                    // while this is the row it moves.
                    property <length> offset: root.swipe-key == self.swipe-key ? root.swipe-offset : 0px;
                    property <bool> focus-here: root.focus-target == self.swipe-key;
                    // The bubble's text colour, on its fill.
                    property <color> ink: row.outbound ? Palette.on-primary-container : Palette.on-surface;
                    // The bubble sits at the left: received left to right, or
                    // sent right to left.
                    property <bool> at-left: row.outbound == root.rtl;
                    property <TextHorizontalAlignment> text-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    property <string> source-label: item.show-source ? root.show-formatted-label : root.show-source-label;
                    accessible-role: list-item;
                    accessible-label: row.label;
                    accessible-item-index: index;
                    accessible-item-count: root.messages.length;
                    changed has-focus => {
                        if (self.has-focus) { root.focus-id = "item:" + row.handle; }
                    }
                    // The bubble is the row's one focus stop besides its links,
                    // and every focus rule's "first control" (swipe spec
                    // section 7, revised for #304 F2).
                    property <int> focus-seq: root.focus-seq;
                    changed focus-seq => {
                        if (self.focus-here) { self.focus(); }
                    }
                    // Its menu holds the actions, at rest nothing does: by
                    // long-press, Enter, the Menu key, Shift+F10, a secondary
                    // click, or the default action a screen reader activates.
                    function open-menu() {
                        root.open-row-menu(row.handle, row.actions, item.source-label, row.label,
                            bubble-column.absolute-position.x, bubble-column.absolute-position.y,
                            bubble-column.width, bubble-column.height);
                    }
                    accessible-action-default => { self.open-menu(); }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Menu
                            || (event.text == Key.F10 && event.modifiers.shift)) {
                            self.open-menu();
                            return accept;
                        }
                        reject
                    }
                    // Toggled from the menu, which lives outside the row.
                    property <int> source-seq: root.source-toggle-seq;
                    changed source-seq => {
                        if (root.source-toggle == row.handle) { self.show-source = !self.show-source; }
                    }
                    animate offset {
                        duration: root.swipe-tracking || root.reduced-motion ? 0ms : 200ms;
                        easing: ease-out;
                    }
                    Rectangle {
                    // The toolkit's handler takes a drag away from the controls
                    // inside it once it moves in a direction this row offers;
                    // what the drag MEANS is decided in Rust (gesture.rs), by
                    // section 4's rule rather than the handler's own.
                    swipe-area := SwipeGestureHandler {
                        enabled: row.end-kind != SwipeKind.none || row.start-kind != SwipeKind.none;
                        handle-swipe-right: root.rtl ? row.start-kind != SwipeKind.none : row.end-kind != SwipeKind.none;
                        handle-swipe-left: root.rtl ? row.end-kind != SwipeKind.none : row.start-kind != SwipeKind.none;
                        moved => {
                            root.swipe-moved(item.swipe-key,
                                self.absolute-position.x + self.pressed-position.x,
                                self.absolute-position.y + self.pressed-position.y,
                                self.absolute-position.x + self.current-position.x,
                                self.absolute-position.y + self.current-position.y,
                                self.width, root.width);
                        }
                        swiped => { root.swipe-ended(item.swipe-key); }
                        cancelled => { root.swipe-cancelled(item.swipe-key); }
                        if item.offset != 0px: SwipeReveal {
                            // The row moved toward the line's end: its end action.
                            property <bool> toward-end: (item.offset > 0px) != root.rtl;
                            kind: self.toward-end ? row.end-kind : row.start-kind;
                            label: self.toward-end ? row.end-label : row.start-label;
                            armed: root.swipe-armed;
                            at-left: item.offset > 0px;
                            reduced-motion: root.reduced-motion;
