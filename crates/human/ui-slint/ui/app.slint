                        spacing: 4px;
                        // A received message on the start side, a sent one on
                        // the end side, mirrored right to left.
                        HorizontalLayout {
                            alignment: row.outbound != root.rtl ? end : start;
                            vertical-stretch: 1;
                                bubble-column := VerticalLayout {
                                    // At most 80 % of the list's width: the
                                    // text wraps inside it.
                                    width: min(self.preferred-width, root.message-width * 0.8);
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 8px;
                                    padding-bottom: 6px;
                                    spacing: 4px;
