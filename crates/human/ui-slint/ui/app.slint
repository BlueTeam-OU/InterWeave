                                            if line.kind != LineKind.rule && line.kind != LineKind.code: Text {
                                                horizontal-stretch: 1;
                                                text: line.text;
                                                wrap: word-wrap;
                                                // A word longer than the line breaks inside itself rather
                                                // than widening the list (seen with a long URL in the body).
                                                min-width: 0;
                                                color: item.ink;
                                                font-weight: line.kind == LineKind.heading || line.kind == LineKind.table-header ? 700 : 400;
                                                // Section 4: headings 20, 18, then 16 like the text.
                                                font-size: line.kind != LineKind.heading ? Type.body-large
                                                    : line.level == 1 ? 20rem / 14
                                                    : line.level == 2 ? 18rem / 14
                                                    : Type.body-large;
                                                horizontal-alignment: item.text-alignment;
                                                accessible-role: text;
                                                accessible-label: line.marker != "" ? line.marker + " " + self.text : self.text;
                                            }
