                                                horizontal-stretch: 1;
                                                background: Palette.surface;
                                                border-radius: 4px;
                                                // Its text's height, padded 6 px round.
                                                height: code-text.preferred-height + 12px;
                                                code-text := Text {
                                                    x: 6px;
                                                    y: 6px;
                                                    width: parent.width - 12px;
                                                    text: line.text;
                                                    wrap: word-wrap;
                                                    color: Palette.on-surface;
                                                    font-family: root.code-font;
                                                    font-size: Type.body-medium;
                                                    accessible-role: text;
                                                    accessible-label: line.marker != "" ? line.marker + " " + self.text : self.text;
                                                }
                                            }
                                            if line.marker != "" && root.rtl: Text {
                                                horizontal-stretch: 0;
                                                text: line.marker;
                                                color: item.ink;
                                                font-size: Type.body-large;
                                                accessible-role: none;
                                            }
                                            if line.quoted && root.rtl: Rectangle {
                                                width: 3px;
                                                background: item.ink;
                                            }
                                        }
                                    }
                                    if item.show-source: Text {
                                        text: row.source;
                                        wrap: word-wrap;
                                        // A word longer than the line breaks inside itself rather
                                        // than widening the list (seen with a long URL in the body).
                                        min-width: 0;
                                        color: item.ink;
                                        font-family: root.code-font;
                                        font-size: Type.body-medium;
                                        accessible-role: text;
                                        accessible-label: self.text;
                                    }
                                    // One control per link, after the text it came from, its full
                                    // destination as its label; nothing opens but a person's
                                    // activation. Part of the drawn body: the source shown in
                                    // its place has none, as a body past a bound has none.
                                    if !item.show-source: VerticalLayout {
                                        for link in row.links: LinkButton {
                                            text: link.label;
                                            ink: row.outbound ? Palette.on-primary-container : Palette.primary;
                                            focus-key: "link:" + row.handle + ":" + link.index;
                                            pressed => { root.link(row.handle, link.index); }
                                            focused(k) => { root.focus-id = k; }
                                        }
                                    }
                                    // The reason above the status, so the status
                                    // and time stay the bubble's last line; only
                                    // drawn when there is one, so an empty line
                                    // takes no room (#304 F9 step 5).
                                    if row.reason != "": Text {
                                        text: row.reason;
                                        font-size: Type.body-small;
                                        color: Palette.error;
                                        wrap: word-wrap;
                                        min-width: 0px;
                                        horizontal-alignment: root.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                                        accessible-role: text;
                                        accessible-label: self.text;
                                    }
                                    // The status with its icon, then the time, at
                                    // the bubble's end (section 6). Not a live
                                    // region: the window's one announcement says
                                    // what changed (rust-ui-dev F4).
                                    HorizontalLayout {
                                        alignment: root.rtl ? start : end;
                                        spacing: 4px;
                                        if row.status-dot: VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: Palette.unread-dot;
                                            }
                                        }
                                        if row.status-glyph != Glyph.none: VerticalLayout {
                                            alignment: center;
                                            GlyphIcon {
                                                width: 16px;
                                                height: 16px;
                                                glyph: row.status-glyph;
                                                ink: row.status-error ? Palette.error : Palette.on-surface-variant;
                                            }
                                        }
                                        // The words may wrap; the time never shrinks:
                                        // a long status ran the time off the bubble's
                                        // end on a phone (#304 round 2).
                                        Text {
                                            text: row.status;
                                            font-size: Type.body-small;
                                            color: row.status-error ? Palette.error : Palette.on-surface-variant;
                                            wrap: word-wrap;
                                            min-width: 0px;
                                            horizontal-alignment: root.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                                            accessible-role: text;
                                            accessible-label: self.text;
                                        }
                                        Text {
                                            text: "·";
                                            font-size: Type.body-small;
                                            color: Palette.on-surface-variant;
                                            min-width: self.preferred-width;
                                            accessible-role: none;
                                        }
                                        Text {
                                            text: row.time;
                                            font-size: Type.body-small;
                                            color: Palette.on-surface-variant;
                                            min-width: self.preferred-width;
                                            accessible-role: text;
                                            accessible-label: self.text;
                                        }
                                    }
                                }
                        }
                    }
                    }
                        }
                        }
                    }
                    }
                    FocusRing {
                        x: -5px;
                        y: -5px;
                        width: item.width + 10px;
                        height: item.height + 10px;
                        shown: item.has-focus;
                    }
                }
            }
            }
            }
            }
            }
            // The snackbar (swipe spec section 6): above the composer,
            // never over it; one at a time.
            if root.snack-shown && !root.snack-on-list: Snackbar {
                text: root.snack-text;
                undo: root.snack-undo;
                undo-label: root.undo-label;
                snack-id: root.snack-id;
                focus-seq: root.focus-seq;
                rtl: root.rtl;
                undo-pressed(id) => { root.undo(id); }
                dismissed(id) => { root.snack-closed(id); }
                focused(k) => { root.focus-id = k; }
            }
            // The refused line and the composer are one row of the pane, so an
            // empty line costs no spacing either: with the keyboard up in
            // landscape its 25 px were most of the strip left to the messages
            // (#304 F9 step 5).
            VerticalLayout {
                vertical-stretch: 0;
                spacing: root.refused != "" && root.composer-enabled ? 8px : 0px;
                // A refused send is announced: the primary action's failure is
                // otherwise silent to a screen reader (rust-ui-dev F3).
                Text {
                    // No height while empty: an empty line kept its own and the
                    // spacing after it.
                    height: root.refused == "" ? 0px : self.preferred-height;
                    text: root.refused;
                    color: Palette.error;
                    accessible-role: text;
                    accessible-label: self.text;
                    accessible-live-region: polite;
                }
                // The composer (section 6): a filled, fully rounded field and a
                // round Send. It exists only for an open conversation: an
                // empty, disabled box would offer nothing to type into.
                // The field, then Send: one order in the tree in both
                // directions, so Tab and a screen reader reach the field first.
                // Send is placed rather than laid out, at the line's end -- the
                // right, or the left right to left -- as the snackbar's Undo is
                // (tests/look.rs, `the_composer_mirrors_right_to_left`).
                // Its own height, the field's lines and their padding: in the
                // pane's layout a box without one took the free space under
                // the messages (#304 F3).
                if root.composer-enabled: Rectangle {
                    vertical-stretch: 0;
                    height: max(48px, input.preferred-height + 24px);
                    init => { root.composer-height = self.height; }
                    changed height => { root.composer-height = self.height; }
                    HorizontalLayout {
                        spacing: 8px;
                        if root.rtl: Rectangle { width: 48px; }
                        composer-box := Rectangle {
                            min-height: 48px;
                            background: Palette.surface-container-high;
                            border-radius: self.height / 2;
                            // The field is its whole box, as a Material text
                            // field is: a tap above or below its line of text
                            // focuses it too. Under the input, which keeps its
                            // own taps for the cursor.
                            TouchArea {
                                clicked => {
                                    FocusMode.keyboard = false;
                                    input.focus();
                                }
                            }
                            FocusRing {
                                x: -5px;
                                y: -5px;
                                width: composer-box.width + 10px;
                                height: composer-box.height + 10px;
                                radius: composer-box.height / 2;
                                shown: input.has-focus;
                            }
                            // The placeholder: the field's own label, "Message",
                            // shown while it is empty. Not a second node.
                            if root.draft == "": Text {
                                x: 20px;
                                width: parent.width - 40px;
                                height: parent.height;
                                text: root.composer-label;
                                font-size: Type.body-large;
                                color: Palette.on-surface-variant;
                                vertical-alignment: center;
                                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                accessible-role: none;
                            }
                            input := TextInput {
                                x: 20px;
                                width: parent.width - 40px;
                                height: self.preferred-height;
                                y: (parent.height - self.height) / 2;
                                vertical-alignment: center;
                                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                font-size: Type.body-large;
                                color: Palette.on-surface;
                                text <=> root.draft;
                                enabled: root.composer-enabled;
                                accessible-label: root.composer-label;
                                // Closing the keyboard keeps the field focused, as
                                // a platform field does. Letting focus go there
                                // (b010afb9) never removed the insertion handle it
                                // was for -- Slint 1.18.1's Android backend leaves
                                // the handle drawn on any focus loss, a toolkit
                                // limit carried as #304's F3 residual -- and is the
                                // suspect in F16, a composer that took no focus on
                                // a tap.
                                edited => { root.draft-edited(self.text); }
                                changed has-focus => {
                                    if (self.has-focus) { root.focus-id = "composer"; }
                                }
                            }
                        }
                        if !root.rtl: Rectangle { width: 48px; }
                    }
                    IconButton {
                        x: root.rtl ? 0px : parent.width - self.width;
                        y: (parent.height - self.height) / 2;
                        glyph: Glyph.send;
                        rtl: root.rtl;
                        label: root.send-label;
                        filled: true;
                        // Dimmed and inactive while the field is empty.
                        active: root.draft != "";
                        focus-key: "send";
                        pressed => { root.send(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
            }
        }
    }
    // Never drawn: measures "Trust this peer" for the trust page's field
    // row, placed so it takes no room in any layout.
    add-measure := Text {
        x: 0;
        y: 0;
        visible: false;
        text: root.add-label;
        font-size: Type.label-large;
        font-weight: 500;
        accessible-role: none;
    }
    // Over everything: a press outside the menu or Details closes it, as
    // Escape does.
    if root.menu-open || root.details-open || root.chats-menu-open: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clicked => {
            FocusMode.keyboard = false;
            if (root.chats-menu-open) {
                root.close-chats-menu();
            } else {
                root.close-menu();
            }
        }
        Rectangle {
            background: root.details-open ? #00000052 : transparent;
        }
    }
    // The app's options (#304 F12), under their button at the Chats bar's
    // end: the list pane's, which starts after the left inset.
    if root.chats-menu-open: Rectangle {
        x: root.rtl ? root.safe-area-insets.left + 8px
            : root.safe-area-insets.left + root.list-width - self.width - 8px;
        y: root.safe-area-insets.top + 56px;
        width: max(200px, chats-menu-items.preferred-width);
        height: chats-menu-items.preferred-height;
        background: Palette.surface-container-high;
        border-radius: 4px;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000052;
        chats-menu-items := VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            MenuItem {
                text: root.trust-heading;
                focus-key: "app-trust";
                first: true;
                rtl: root.rtl;
                pressed => {
                    root.chats-menu-open = false;
                    root.open-settings();
                }
                closed => { root.close-chats-menu(); }
                focused(k) => { root.focus-id = k; }
            }
            // After Trust (section 4): the addresses are their own
            // decision, apart from trust.
            MenuItem {
                text: root.peers-title;
                focus-key: "app-peers";
                rtl: root.rtl;
                pressed => {
                    root.chats-menu-open = false;
                    root.open-peers-page();
                }
                closed => { root.close-chats-menu(); }
                focused(k) => { root.focus-id = k; }
            }
        }
    }
    // The overflow menu (section 6), under its button at the line's end.
    if root.menu-open: Rectangle {
        x: root.rtl ? root.safe-area-insets.left + 8px
            : root.width - self.width - root.safe-area-insets.right - 8px;
        y: root.safe-area-insets.top + 56px;
        width: max(200px, menu-items.preferred-width);
        height: menu-items.preferred-height;
        background: Palette.surface-container-high;
        border-radius: 4px;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000052;
        menu-items := VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            if root.hide-conversation-shown: MenuItem {
                text: root.hide-conversation-label;
                detail: root.header-title;
                focus-key: "hide-conversation";
                first: true;
                rtl: root.rtl;
                pressed => {
                    root.close-menu();
                    root.list-shown = true;
                    root.hide-conversation();
                }
                closed => { root.close-menu(); }
                focused(k) => { root.focus-id = k; }
            }
            MenuItem {
                text: root.details-label;
                focus-key: "details";
                first: !root.hide-conversation-shown;
                rtl: root.rtl;
                pressed => {
                    root.menu-open = false;
                    root.details-open = true;
                }
                closed => { root.close-menu(); }
                focused(k) => { root.focus-id = k; }
            }
        }
    }
    // A message's menu (swipe spec section 7, look spec section 6): its
    // actions in the row's order, Show source last, each 48 high with its
    // icon, anchored under the bubble -- over it when the space below runs
    // out. Focus opens on its first item; an item chosen, Escape, Back or a
    // tap outside closes it. Its items keep the focus keys the row's
    // buttons had, so the view's focus rules read focus here as the row's.
    if root.row-menu >= 0: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clicked => {
            FocusMode.keyboard = false;
            root.close-row-menu();
        }
    }
    if root.row-menu >= 0: row-menu-box := Rectangle {
        property <length> below: root.row-menu-y + root.row-menu-h + 4px;
        width: min(root.width - 16px, max(200px, row-menu-items.preferred-width));
        height: row-menu-items.preferred-height;
        x: max(8px, min(root.row-menu-x, root.width - self.width - 8px));
        y: self.below + self.height <= root.height - root.safe-area-insets.bottom - 8px ? self.below
            : max(root.safe-area-insets.top + 8px, root.row-menu-y - self.height - 4px);
        background: Palette.surface-container-high;
        border-radius: 4px;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000052;
        // A press on the menu is the menu's, not the scrim's.
        TouchArea {}
        row-menu-items := VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            for action in root.row-menu-actions: MenuItem {
                text: action.text;
                detail: root.row-menu-detail;
                iconed: true;
                kind: action.kind;
                focus-key: "action:" + root.row-menu + ":" + action.index;
                first: action.index == 0;
                rtl: root.rtl;
                pressed => {
                    // Closed first, focus on its bubble, which the action's
                    // own rule may then move (Dismiss, Cancel: the next row).
                    let handle = root.row-menu;
                    root.close-row-menu();
                    root.action(handle, action.index);
                }
                closed => { root.close-row-menu(); }
                focused(k) => { root.focus-id = k; }
            }
            MenuItem {
                text: root.row-menu-source;
                detail: root.row-menu-detail;
                iconed: true;
                glyph: Glyph.source;
                focus-key: "source:" + root.row-menu;
                first: root.row-menu-actions.length == 0;
                rtl: root.rtl;
                pressed => {
                    root.source-toggle = root.row-menu;
                    root.source-toggle-seq += 1;
                    root.close-row-menu();
                }
                closed => { root.close-row-menu(); }
                focused(k) => { root.focus-id = k; }
            }
        }
    }
    // The trust change waiting for the person, as a dialog over a scrim
    // (#304 F4 at 3b19110a): the question with its exact PeerId and what
    // follows, "Do not change" focused, and a button naming the act. A
    // tap on the scrim, Escape and Back are "Do not change".
    if root.trust-page && root.has-pending: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clicked => {
            FocusMode.keyboard = false;
            root.trust-cancel();
        }
        Rectangle { background: #00000052; }
    }
    if root.trust-page && root.has-pending: pending := FocusScope {
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
            if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
        }
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 48px, 560px);
        height: pending-box.preferred-height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.trust-cancel();
                return accept;
            }
            // A modal dialog keeps focus on its two buttons.
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                FocusMode.keyboard = true;
                root.focus-target = root.focus-id == "trust-cancel" ? "trust-confirm" : "trust-cancel";
                root.focus-seq += 1;
                return accept;
            }
            reject
        }
        pending-box := Rectangle {
            background: Palette.surface-container-high;
            border-radius: 28px;
            // A press on the dialog is the dialog's, not the scrim's.
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 24px;
                Text {
                    text: root.pending-text;
                    color: Palette.on-surface;
                    font-size: Type.body-medium;
                    wrap: word-wrap;
                    // The exact PeerId is one word wider than a phone: as
                    // the text's minimum it would lay the dialog past the
                    // window's edge. Without it the PeerId breaks whole.
                    min-width: 0px;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                // At the line's end, "Do not change" before the act; right
                // to left both mirror, as a layout does not on its own.
                if !root.rtl: HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ActionButton {
                        text: root.cancel-label;
                        detail: root.pending-text;
                        text-button: true;
                        target: 48px;
                        focus-key: "trust-cancel";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "trust-cancel";
                        pressed => { root.trust-cancel(); }
                        focused(k) => { root.focus-id = k; }
                        init => { self.focus(); }
                    }
                    ActionButton {
                        text: root.confirm-label;
                        detail: root.pending-text;
                        text-button: true;
                        target: 48px;
                        focus-key: "trust-confirm";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "trust-confirm";
                        pressed => { root.trust-confirm(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
                if root.rtl: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ActionButton {
                        text: root.confirm-label;
                        detail: root.pending-text;
                        text-button: true;
                        target: 48px;
                        focus-key: "trust-confirm";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "trust-confirm";
                        pressed => { root.trust-confirm(); }
                        focused(k) => { root.focus-id = k; }
                    }
                    ActionButton {
                        text: root.cancel-label;
                        detail: root.pending-text;
                        text-button: true;
                        target: 48px;
                        focus-key: "trust-cancel";
                        focus-seq: root.focus-seq;
                        focus-wanted: root.focus-target == "trust-cancel";
                        pressed => { root.trust-cancel(); }
                        focused(k) => { root.focus-id = k; }
                        init => { self.focus(); }
                    }
                }
            }
        }
    }
    // Details (#304 F11, a Material basic dialog): the conversation's
    // title, its identifier whole in the code font -- text, not a field --
    // and for a direct one the route as the peer named it, unverified;
    // Copy puts the identifier on the clipboard and closes, focus back on
    // the overflow button (human-client-ui.md section 11).
    if root.details-open: details := FocusScope {
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) { FocusMode.keyboard = true; }
            if (reason == FocusReason.pointer-click) { FocusMode.keyboard = false; }
        }
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 48px, 560px);
        height: details-box.preferred-height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-menu();
                return accept;
            }
            // A modal dialog keeps focus: Tab either way moves between its
            // two actions, never to the controls behind the scrim.
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                FocusMode.keyboard = true;
                if (details-copy.has-focus) {
                    details-close.focus();
                } else {
                    details-copy.focus();
                }
                return accept;
            }
            reject
        }
        // Focus moves to Copy once Details is in the window.
        property <bool> taken;
        Timer {
            interval: 1ms;
            running: !details.taken;
            triggered => {
                details.taken = true;
                details-copy.focus();
            }
        }
        // What Copy copies: the identifier, through the platform's
        // clipboard as a field's copy would. Never shown.
        copy-source := TextInput {
            x: 0;
            y: 0;
            width: 0;
            height: 0;
            visible: false;
            read-only: true;
            text: root.header-id;
            accessible-role: none;
        }
        details-box := Rectangle {
            background: Palette.surface-container-high;
            border-radius: 28px;
            // A press on the dialog is the dialog's and moves no focus.
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text {
                    text: root.header-title;
                    font-size: Type.title-large;
                    wrap: word-wrap;
                    color: Palette.on-surface;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.details-id-label;
                        font-size: Type.body-small;
                        font-weight: 700;
                        color: Palette.on-surface-variant;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    Text {
                        text: root.header-id;
                        font-family: root.code-font;
                        font-size: Type.body-medium;
                        wrap: char-wrap;
                        color: Palette.on-surface;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                }
                if root.details-route != "": Text {
                    text: root.details-route;
                    font-size: Type.body-medium;
                    wrap: word-wrap;
                    color: Palette.on-surface-variant;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    details-close := ActionButton {
                        text: root.close-label;
                        text-button: true;
                        target: 48px;
                        focus-key: "details-close";
                        pressed => { root.close-menu(); }
                        focused(k) => { root.focus-id = k; }
                    }
                    details-copy := ActionButton {
                        text: root.details-copy-label;
                        text-button: true;
                        target: 48px;
                        focus-key: "details-copy";
                        pressed => {
                            copy-source.select-all();
                            copy-source.copy();
                            copy-source.clear-selection();
                            root.close-menu();
                            root.identifier-copied();
                        }
                        focused(k) => { root.focus-id = k; }
                    }
                }
            }
        }
    }

    if root.identity-active: IdentityScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        page: root.identity;
        rtl: root.rtl;
        code-font: root.code-font;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        primary => { root.identity-primary(); }
        secondary => { root.identity-secondary(); }
        tertiary => { root.identity-tertiary(); }
        back => { root.identity-back(); }
        key(letter) => { root.identity-key(letter); }
        delete-letter => { root.identity-delete(); }
        clear-word => { root.identity-clear(); }
        chip(word) => { root.identity-chip(word); }
        slot(i) => { root.identity-slot(i); }
        dialog(delete) => { root.identity-dialog(delete); }
        init => { self.focus(); }
    }
}

// The desktop's start-up refusal screen (plan section 18 clause (4), as
// decided 2026-10-20): its own small window, shown instead of the app's
// when the profile, its lock or its store refuses at start. It holds no
// session and no lease and writes nothing; it says why, names the file,
// and offers Close always and Try again where trying again can change
// the answer. Every string arrives from Rust, from ui-model's table.
export component RefusalWindow inherits Window {
    in property <string> window-title;
    in property <string> heading;
    in property <string> reason;
    // The file or folder the refusal is about, whole and selectable to
    // copy; empty when the refusal names none.
    in property <string> path;
    in property <string> path-label;
    in property <string> close-label;
    in property <string> retry-label;
    in property <bool> can-retry;
    // Delete stored data… on the store's recovery screen (ADR-0060
    // decision 6; design 2026-10-21 section 7): offered there only.
    in property <bool> can-discard;
    in property <string> discard-label;
    // While the discard's plan is built or the discard runs: every action
    // inert, Escape ignored (a half-done discard cannot be left).
    in property <bool> busy;
    // The line under the heading: Checking, Deleting, or the failure.
    in property <string> progress;
    // The discard's confirmation, over a scrim: its title, the list of
    // what goes (one item per line), its notes, then Cancel -- the
    // initial focus, so Enter alone never discards -- and the primary.
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-lead;
    in property <[string]> dialog-items;
    // What stays, and what the device may still hold: at most two notes.
    in property <string> dialog-note-a;
    in property <string> dialog-note-b;
    in property <string> dialog-confirm-label;
    in property <bool> dialog-danger;
    in property <string> cancel-label;
    in property <string> code-font;
    // The live region (as AppWindow's): two slots taking turns, so the
    // same status after a second Try again is still a change a screen
    // reader hears.
    in property <string> status-a;
    in property <string> status-b;
    // As AppWindow's: the focused element reports itself, for the tests.
    in-out property <string> focus-id;
    callback retry();
    callback close-screen();
    callback discard();
    callback dialog-cancel();
    callback dialog-confirm();
    property <int> dialog-focus-seq;
    property <string> dialog-focus: "dialog-cancel";
    // Called by Rust when the confirmation opens: Cancel takes focus.
    public function focus-dialog() {
        root.dialog-focus = "dialog-cancel";
        root.dialog-focus-seq += 1;
    }
    // Called by Rust when the screen opens or changes: focus goes to the
    // action a person most likely wants, Try again where it is offered.
    // Try again is conditional, so it is out of the layout when not
    // offered (hidden, it kept its space and pushed Close off the edge,
    // seen in the window); it takes focus through this sequence.
    property <int> retry-focus-seq;
    public function focus-primary() {
        if (root.can-retry) {
            root.retry-focus-seq += 1;
        } else {
            close-button.focus();
        }
    }
    title: root.window-title;
    icon: @image-url("assets/interweave-icon-256.png");
    background: Palette.surface;
    preferred-width: 520px;
    // Stated, not taken from the text: a window sizes itself before its
    // wrapped lines are measured at its width, so it opened shorter than
    // its content and cut off the actions (seen in the window). What does
    // not fit scrolls above the actions, which stay in view. 520 holds the
    // full discard's confirmation, title to buttons, without a scroll at
    // the preferred width (its list read whole, design 2026-10-21 §7.2).
    preferred-height: 520px;
    min-width: 320px;
    min-height: 200px;
    // Escape closes, as the window's own close does: Close is never
    // further away than one key. A key the focused control rejects
    // reaches this scope; Tab never stops on it, as it does nothing.
    FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.dialog-open) {
                    root.dialog-cancel();
                } else if (!root.busy) {
                    root.close-screen();
                }
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Flickable {
                vertical-stretch: 1;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    width: parent.width;
                    spacing: 16px;
                    Text {
                        text: root.heading;
                        font-size: Type.title-large;
                        font-weight: 700;
                        color: Palette.on-surface;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    if root.progress != "": Text {
                        text: root.progress;
                        font-size: Type.body-medium;
                        color: Palette.on-surface-variant;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: self.text;
                        accessible-live-region: polite;
                    }
                    Text {
                        text: root.reason;
                        font-size: Type.body-large;
                        color: Palette.on-surface;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    if root.path != "": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: root.path-label;
                            font-size: Type.body-small;
                            font-weight: 700;
                            color: Palette.on-surface-variant;
                            accessible-role: none;
                        }
                        // Sized by a wrapping Text under the field: a read-only
                        // field's height does not follow its wrapped lines, so a
                        // long path overran the box and the window cut off its
                        // buttons (seen in the window). The Text is transparent
                        // and out of the tree; the field over it is what is read,
                        // selected and copied.
                        path-box := Rectangle {
                            vertical-stretch: 0;
                            VerticalLayout {
                                Text {
                                    text: root.path;
                                    wrap: char-wrap;
                                    font-family: root.code-font;
                                    font-size: Type.body-medium;
                                    color: transparent;
                                    accessible-role: none;
                                }
                            }
                            path-input := TextInput {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                text: root.path;
                                read-only: true;
                                // Whole over as many lines as it needs, never cut:
                                // a path has no spaces to wrap at.
                                single-line: false;
                                wrap: char-wrap;
                                font-family: root.code-font;
                                font-size: Type.body-medium;
                                color: Palette.on-surface;
                                accessible-label: root.path-label;
                                accessible-value: self.text;
                                changed has-focus => {
                                    if (self.has-focus) { root.focus-id = "path"; }
                                }
                            }
                            FocusRing {
                                x: -5px;
                                y: -5px;
                                width: path-box.width + 10px;
                                height: path-box.height + 10px;
                                shown: path-input.has-focus;
                            }
                        }
                    }
                    VerticalLayout {
                        Text {
                            text: root.status-a;
                            font-size: Type.body-medium;
                            color: Palette.on-surface-variant;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-label: self.text;
                            accessible-live-region: polite;
                        }
                        Text {
                            text: root.status-b;
                            font-size: Type.body-medium;
                            color: Palette.on-surface-variant;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-label: self.text;
                            accessible-live-region: polite;
                        }
                    }
                }
            }
            // Delete stored data… on a line of its own, above the others
            // and at the start side, apart from them: three actions do not
            // fit one line of a 320 px window (seen), and a layout cannot
            // ask the window's width without a binding loop (Slint 1.18).
            VerticalLayout {
                spacing: 12px;
                if root.can-discard: HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: root.discard-label;
                        focus-key: "discard";
                        target: 40px;
                        danger: true;
                        pressed => {
                            if (!root.busy && !root.dialog-open) { root.discard(); }
                        }
                        focused(key) => { root.focus-id = key; }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle { horizontal-stretch: 1; }
                    close-button := ActionButton {
                        text: root.close-label;
                        focus-key: "close";
                        target: 40px;
                        text-button: true;
                        pressed => {
                            if (!root.busy && !root.dialog-open) { root.close-screen(); }
                        }
                        focused(key) => { root.focus-id = key; }
                    }
                    if root.can-retry: ActionButton {
                        text: root.retry-label;
                        focus-key: "retry";
                        target: 40px;
                        filled: true;
                        focus-seq: root.retry-focus-seq;
                        focus-wanted: true;
                        pressed => {
                            if (!root.busy && !root.dialog-open) { root.retry(); }
                        }
                        focused(key) => { root.focus-id = key; }
                    }
                }
            }
        }
    }
    // The scrim: a press outside the confirmation is Cancel.
    if root.dialog-open: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clicked => { root.dialog-cancel(); }
        Rectangle { background: #00000052; }
    }
    if root.dialog-open: FocusScope {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 32px, 560px);
        height: min(root.height - 32px, dialog-box.preferred-height);
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dialog-cancel();
                return accept;
            }
            // A modal dialog keeps focus on its two buttons.
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                root.dialog-focus = root.focus-id == "dialog-cancel" ? "dialog-confirm" : "dialog-cancel";
                root.dialog-focus-seq += 1;
                return accept;
            }
            reject
        }
        dialog-box := Rectangle {
            background: Palette.surface-container-high;
            border-radius: 28px;
            // A press on the dialog is the dialog's, not the scrim's.
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text {
                    text: root.dialog-title;
                    font-size: Type.title-large;
                    color: Palette.on-surface;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: dialog-body.preferred-height;
                    min-height: min(dialog-body.preferred-height, 120px);
                    dialog-body := VerticalLayout {
                        width: parent.width;
                        spacing: 8px;
                        if root.dialog-lead != "": Text {
                            text: root.dialog-lead;
                            font-size: Type.body-medium;
                            color: Palette.on-surface;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-label: self.text;
                        }
                        for item in root.dialog-items: HorizontalLayout {
                            spacing: 8px;
                            accessible-role: list-item;
                            accessible-label: item;
                            Text {
                                text: "•";
                                font-size: Type.body-medium;
                                color: Palette.on-surface;
                                accessible-role: none;
                            }
                            Text {
                                text: item;
                                font-size: Type.body-medium;
                                color: Palette.on-surface;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                accessible-role: none;
                            }
                        }
                        if root.dialog-note-a != "": Text {
                            text: root.dialog-note-a;
                            font-size: Type.body-medium;
                            color: Palette.on-surface-variant;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-label: self.text;
                        }
                        if root.dialog-note-b != "": Text {
                            text: root.dialog-note-b;
                            font-size: Type.body-medium;
                            color: Palette.on-surface-variant;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-label: self.text;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ActionButton {
                        text: root.cancel-label;
                        text-button: true;
                        target: 48px;
                        focus-key: "dialog-cancel";
                        focus-seq: root.dialog-focus-seq;
                        focus-wanted: root.dialog-focus == "dialog-cancel";
                        pressed => { root.dialog-cancel(); }
                        focused(k) => { root.focus-id = k; }
                        init => { self.focus(); }
                    }
                    ActionButton {
                        text: root.dialog-confirm-label;
                        filled: true;
                        danger: root.dialog-danger;
                        target: 48px;
                        focus-key: "dialog-confirm";
                        focus-seq: root.dialog-focus-seq;
                        focus-wanted: root.dialog-focus == "dialog-confirm";
                        pressed => { root.dialog-confirm(); }
                        focused(k) => { root.focus-id = k; }
                    }
                }
            }
        }
    }
}
