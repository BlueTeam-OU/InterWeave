                                        font-size: Type.title-small;
                                        font-weight: 500;
                                        color: Palette.primary;
                                        horizontal-alignment: item.text-alignment;
                                        accessible-role: text;
                                        accessible-label: self.text;
                                        accessible-description: row.author-id;
