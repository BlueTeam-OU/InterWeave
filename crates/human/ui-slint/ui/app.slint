                                        spacing: 6px;
                                        // The start bar: on the right, right to
                                        // left.
                                        if !root.rtl: Rectangle {
                                            width: 3px;
                                            background: item.ink;
                                        }
                                        Text {
                                            text: row.reply;
                                            font-size: Type.body-small;
                                            color: Palette.on-surface-variant;
                                            wrap: word-wrap;
                                            min-width: 0;
                                            horizontal-stretch: 1;
                                            horizontal-alignment: item.text-alignment;
                                            accessible-role: text;
                                            accessible-label: self.text;
                                        }
                                        if root.rtl: Rectangle {
                                            width: 3px;
                                            background: item.ink;
                                        }
                                    }
                                    if !item.show-source: VerticalLayout {
                                        spacing: 4px;
                                        // Mirrored right to left (section 7): the
                                        // indent, the quote bar and a list's marker
                                        // at the line's start, on the right.
                                        for line in row.lines: HorizontalLayout {
                                            padding-left: root.rtl ? 0px : line.depth * 16px;
                                            padding-right: root.rtl ? line.depth * 16px : 0px;
                                            spacing: 6px;
                                            if line.quoted && !root.rtl: Rectangle {
                                                width: 3px;
                                                background: item.ink;
                                            }
                                            if line.marker != "" && !root.rtl: Text {
                                                horizontal-stretch: 0;
                                                text: line.marker;
                                                color: item.ink;
                                                font-size: Type.body-large;
                                                // Said with the line's own label.
                                                accessible-role: none;
                                            }
                                            if line.kind == LineKind.rule: Rectangle {
                                                height: 1px;
                                                background: item.ink;
                                            }
