        }
        if (root.row-menu >= 0) {
            root.close-row-menu();
            return true;
        }
        if (root.chats-menu-open) {
            root.close-chats-menu();
            return true;
        }
        if (root.menu-open || root.details-open) {
            root.close-menu();
