                    // `a_drag_a_row_does_not_offer_leaves_the_next_drag_its_own`).
                    // A press held within the slop for the platform's long-press
                    // time opens the menu, a press past the slop never does,
                    // and a secondary click opens it at once (section 4).
                    row-touch := TouchArea {
                        property <bool> drifted;
