<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: the remoteMessaging foreground-service type's own
         permission (ADR-0041). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- API 33+: posting the Stay-reachable and new-message notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The prompt before the recovery phrase is shown on demand
         (android-key-custody.md). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Scan a code (add-a-peer 5.5; ADR-0062 decision 8 as amended): asked
         by the Activity on a Scan press when not held (MainActivity's
         CAMERA_START). The camera is not a required feature, so a phone
         without one installs and offers typing. CAMERA alone makes the
         platform's store take android.hardware.camera as required, so it
         is declared not required by name (plan s29 step 2), beside the
         any-camera feature the Activity asks for. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- No fullBackupContent: below Android 12 (minSdk 30) allowBackup
         "false" turns off cloud backup and device-to-device transfer alike,
         as SPIKE-008 measured on API 30 (B1, B3); from 12 on only
         dataExtractionRules governs a transfer, so it is set as well. -->
    <application
        tools:ignore="DataExtractionRules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasCode="true">

        <!-- Every change here is handled in place, so the window and what
             it shows survive it. fontScale too: Slint's helper view applies
             a new scale on its configuration change, and a recreation
             dropped an open conversation for Chats (#304 F13).
             One instance: the views run one event loop, bound to the
             Activity that started it. A second instance on top, then
             closed, ended that loop and left the one below drawn and
             dead to every touch and Back (the Pixel, 2026-10-21, build
             f382d5ba). A launch while one exists goes to it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|density|uiMode|fontScale">
            <meta-data
                android:name="android.app.lib_name"
                android:value="interweave_human_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The network service: bound by the Activity in foreground-only
             mode, a remoteMessaging foreground service under Stay
             reachable (ADR-0041). Never exported. -->
        <service
            android:name=".NetworkService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
    </application>
</manifest>
